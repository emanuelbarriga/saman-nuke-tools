set cut_paste_input [stack 0]
version 17.1 v3
push $cut_paste_input
NoOp {
 name ColorSpaces
 onCreate "exec(nuke.thisNode().knob('Cerebro_Python').value(), \{'_CS_ACCION': 'init'\})"
 tile_color 0x8b5cf6ff
 selected true
 xpos -267
 ypos -200
 addUserKnob {20 User}
 addUserKnob {26 hdr l "" +STARTLINE T "<b>ColorSpaces</b> — clasifica Reads por espacio de color"}
 addUserKnob {26 estado l "" +STARTLINE T "<i>Sin clasificar todavía.</i>"}
 addUserKnob {26 sep1 l "" +STARTLINE}
 addUserKnob {26 hdr_clas l Clasificar T " "}
 addUserKnob {22 btn_clasificar l "Clasificar Reads" -STARTLINE T "exec(nuke.thisNode().knob('Cerebro_Python').value(), \{'_CS_ACCION': 'clasificar'\})"}
 addUserKnob {22 btn_limpiar l "Limpiar backdrops" -STARTLINE T "exec(nuke.thisNode().knob('Cerebro_Python').value(), \{'_CS_ACCION': 'limpiar'\})"}
 addUserKnob {26 orden_ayuda l "" -STARTLINE T "Alfabético: A→Z. Cantidad: el espacio con más Reads primero."}
 addUserKnob {4 orden l Orden M {Alfabetico Cantidad}}
 addUserKnob {26 sep2 l "" +STARTLINE}
 addUserKnob {26 hdr_cambio l "Cambiar espacio de color" T " "}
 addUserKnob {26 destino_ayuda l "" -STARTLINE T "Lista tomada de la config OCIO activa. «Recargar lista OCIO» la vuelve a leer."}
 addUserKnob {68 destino l "Espacio destino" M {"aces_interchange\taces_interchange (ACES2065-1)" "cie_xyz_d65_interchange\tcie_xyz_d65_interchange (CIE XYZ-D65 - Display-referred)" "color_picking\tcolor_picking (sRGB Encoded Rec.709 (sRGB))" "color_timing\tcolor_timing (ACEScct)" "compositing_log\tcompositing_log (ACEScct)" "data\tdata (Raw)" "matte_paint\tmatte_paint (ACEScct)" "scene_linear\tscene_linear (ACEScg)" "texture_paint\ttexture_paint (sRGB Encoded Rec.709 (sRGB))" "sRGB - Display\tColorspaces/Display/sRGB - Display\t\tsrgb_display" "Display P3 - Display\tColorspaces/Display/Display P3 - Display\t\tdisplayp3_display" "Display P3 HDR - Display\tColorspaces/Display/Display P3 HDR - Display\t\tdisplayp3_hdr_display" "P3-D65 - Display\tColorspaces/Display/P3-D65 - Display\t\tp3d65_display" "Rec.1886 Rec.709 - Display\tColorspaces/Display/Rec.1886 Rec.709 - Display\t\trec1886_rec709_display" "Rec.2100-HLG - Display\tColorspaces/Display/Rec.2100-HLG - Display\t\trec2100_hlg_display" "Rec.2100-PQ - Display\tColorspaces/Display/Rec.2100-PQ - Display\t\trec2100_pq_display" "ST2084-P3-D65 - Display\tColorspaces/Display/ST2084-P3-D65 - Display\t\tst2084_p3d65_display" "ACES2065-1\tColorspaces/ACES/ACES2065-1\t\taces2065_1,aces,ACES - ACES2065-1,lin_ap0,lin_ap0_scene" "ACEScc\tColorspaces/ACES/ACEScc\t\tACES - ACEScc,acescc_ap1" "ACEScct\tColorspaces/ACES/ACEScct\t\tACES - ACEScct,acescct_ap1" "ACEScg\tColorspaces/ACES/ACEScg\t\tACES - ACEScg,lin_ap1,lin_ap1_scene" "ADX10\tColorspaces/ACES/ADX10\t\tInput - ADX - ADX10" "ADX16\tColorspaces/ACES/ADX16\t\tInput - ADX - ADX16" "Apple Log\tColorspaces/Input/Apple/Apple Log\t\tapple_log" "ARRI LogC3 (EI800)\tColorspaces/Input/ARRI/ARRI LogC3 (EI800)\t\tarri_logc3_ei800,logc3ei800_alexawide,Input - ARRI - V3 LogC (EI800) - Wide Gamut,AlexaV3LogC" "Linear ARRI Wide Gamut 3\tColorspaces/Input/ARRI/Linear ARRI Wide Gamut 3\t\tlin_arri_wide_gamut_3,lin_alexawide,Input - ARRI - Linear - ALEXA Wide Gamut" "ARRI LogC4\tColorspaces/Input/ARRI/ARRI LogC4\t\tarri_logc4,ARRILogC4" "Linear ARRI Wide Gamut 4\tColorspaces/Input/ARRI/Linear ARRI Wide Gamut 4\t\tlin_arri_wide_gamut_4,lin_awg4" "BMDFilm WideGamut Gen5\tColorspaces/Input/BlackmagicDesign/BMDFilm WideGamut Gen5\t\tbmdfilm_widegamut_gen5,Blackmagic Film Generation 5" "Linear BMD WideGamut Gen5\tColorspaces/Input/BlackmagicDesign/Linear BMD WideGamut Gen5\t\tlin_bmd_widegamut_gen5" "DaVinci Intermediate WideGamut\tColorspaces/Input/BlackmagicDesign/DaVinci Intermediate WideGamut\t\tdavinci_intermediate_widegamut" "Linear DaVinci WideGamut\tColorspaces/Input/BlackmagicDesign/Linear DaVinci WideGamut\t\tlin_davinci_widegamut" "CanonLog2 CinemaGamut D55\tColorspaces/Input/Canon/CanonLog2 CinemaGamut D55\t\tcanonlog2_cinemagamut_d55,canonlog2_cgamutday,Input - Canon - Canon-Log2 - Cinema Gamut Daylight" "Linear CinemaGamut D55\tColorspaces/Input/Canon/Linear CinemaGamut D55\t\tlin_cinemagamut_d55,lin_canoncgamutday,Input - Canon - Linear - Canon Cinema Gamut Daylight" "CanonLog3 CinemaGamut D55\tColorspaces/Input/Canon/CanonLog3 CinemaGamut D55\t\tcanonlog3_cinemagamut_d55,canonlog3_cgamutday,Input - Canon - Canon-Log3 - Cinema Gamut Daylight" "Linear V-Gamut\tColorspaces/Input/Panasonic/Linear V-Gamut\t\tlin_vgamut,Input - Panasonic - Linear - V-Gamut" "V-Log V-Gamut\tColorspaces/Input/Panasonic/V-Log V-Gamut\t\tvlog_vgamut,Input - Panasonic - V-Log - V-Gamut" "Linear REDWideGamutRGB\tColorspaces/Input/RED/Linear REDWideGamutRGB\t\tlin_redwidegamutrgb,lin_rwg,Input - RED - Linear - REDWideGamutRGB" "Log3G10 REDWideGamutRGB\tColorspaces/Input/RED/Log3G10 REDWideGamutRGB\t\tlog3g10_redwidegamutrgb,rl3g10_rwg,Input - RED - REDLog3G10 - REDWideGamutRGB,Log3G10" "Linear S-Gamut3\tColorspaces/Input/Sony/Linear S-Gamut3\t\tlin_sgamut3,Input - Sony - Linear - S-Gamut3" "S-Log3 S-Gamut3\tColorspaces/Input/Sony/S-Log3 S-Gamut3\t\tslog3_sgamut3,Input - Sony - S-Log3 - S-Gamut3,SLog3" "Linear S-Gamut3.Cine\tColorspaces/Input/Sony/Linear S-Gamut3.Cine\t\tlin_sgamut3cine,Input - Sony - Linear - S-Gamut3.Cine" "S-Log3 S-Gamut3.Cine\tColorspaces/Input/Sony/S-Log3 S-Gamut3.Cine\t\tslog3_sgamut3cine,slog3_sgamutcine,Input - Sony - S-Log3 - S-Gamut3.Cine" "Linear Venice S-Gamut3\tColorspaces/Input/Sony/Linear Venice S-Gamut3\t\tlin_venice_sgamut3,Input - Sony - Linear - Venice S-Gamut3" "S-Log3 Venice S-Gamut3\tColorspaces/Input/Sony/S-Log3 Venice S-Gamut3\t\tslog3_venice_sgamut3,Input - Sony - S-Log3 - Venice S-Gamut3" "Linear Venice S-Gamut3.Cine\tColorspaces/Input/Sony/Linear Venice S-Gamut3.Cine\t\tlin_venice_sgamut3cine,Input - Sony - Linear - Venice S-Gamut3.Cine" "S-Log3 Venice S-Gamut3.Cine\tColorspaces/Input/Sony/S-Log3 Venice S-Gamut3.Cine\t\tslog3_venice_sgamut3cine,slog3_venice_sgamutcine,Input - Sony - S-Log3 - Venice S-Gamut3.Cine" "sRGB Encoded Rec.709 (sRGB)\tColorspaces/Utility/sRGB Encoded Rec.709 (sRGB)\t\tsrgb_encoded_rec709_srgb,srgb_texture,srgb_rec709_scene,Utility - sRGB - Texture,Input - Generic - sRGB - Texture,sRGB - Texture,srgb_tx" "Gamma 1.8 Encoded Rec.709\tColorspaces/Utility/Gamma 1.8 Encoded Rec.709\t\tg18_encoded_rec709,g18_rec709,Utility - Gamma 1.8 - Rec.709 - Texture,Gamma 1.8 Rec.709 - Texture,g18_rec709_tx,g18_rec709_scene,Gamma1.8" "Gamma 2.2 Encoded Rec.709\tColorspaces/Utility/Gamma 2.2 Encoded Rec.709\t\tg22_encoded_rec709,g22_rec709,Utility - Gamma 2.2 - Rec.709 - Texture,Gamma 2.2 Rec.709 - Texture,g22_rec709_tx,g22_rec709_scene,Gamma2.2" "Gamma 2.4 Encoded Rec.709\tColorspaces/Utility/Gamma 2.4 Encoded Rec.709\t\tg24_encoded_rec709,g24_rec709,rec709_display,Utility - Rec.709 - Display,Gamma 2.4 Rec.709 - Texture,g24_rec709_tx,Gamma2.4" "Camera Rec.709\tColorspaces/Utility/ITU/Camera Rec.709\t\tcamera_rec709,rec709_camera,Utility - Rec.709 - Camera" "sRGB Encoded P3-D65\tColorspaces/Utility/sRGB Encoded P3-D65\t\tsrgb_encoded_p3d65,srgb_p3d65,srgb_displayp3,srgb_p3d65_scene,sRGB Encoded P3-D65 - Texture,srgb_encoded_p3d65_tx" "Gamma 2.2 Encoded AdobeRGB\tColorspaces/Utility/Gamma 2.2 Encoded AdobeRGB\t\tg22_encoded_adobergb,adobergb,g22_adobergb_scene" "sRGB Encoded AP1\tColorspaces/Utility/sRGB Encoded AP1\t\tsrgb_encoded_ap1,srgb_ap1,srgb_ap1_scene,sRGB Encoded AP1 - Texture,srgb_encoded_ap1_tx" "Gamma 2.2 Encoded AP1\tColorspaces/Utility/Gamma 2.2 Encoded AP1\t\tg22_encoded_ap1,g22_ap1,Gamma 2.2 AP1 - Texture,g22_ap1_tx,g22_ap1_scene" "Linear AdobeRGB\tColorspaces/Utility/Linear AdobeRGB\t\tlin_adobergb,lin_adobergb_scene,Utility - Linear - Adobe RGB" "Linear P3-D65\tColorspaces/Utility/Linear P3-D65\t\tlin_p3d65,lin_displayp3,lin_p3d65_scene,Utility - Linear - P3-D65,Linear Display P3" "Linear Rec.2020\tColorspaces/Utility/Linear Rec.2020\t\tlin_rec2020,lin_rec2020_scene,Utility - Linear - Rec.2020" "Linear Rec.709 (sRGB)\tColorspaces/Utility/Linear Rec.709 (sRGB)\t\tlin_rec709_srgb,lin_rec709,lin_rec709_scene,lin_srgb,Utility - Linear - sRGB,Utility - Linear - Rec.709" "Raw\tColorspaces/Utility/Raw\t\tUtility - Raw,none"}}
 addUserKnob {22 btn_buscar l "Buscar espacio…" -STARTLINE T "exec(nuke.thisNode().knob('Cerebro_Python').value(), \{'_CS_ACCION': 'buscar'\})"}
 addUserKnob {22 btn_aplicar l "Aplicar a Reads seleccionados" T "exec(nuke.thisNode().knob('Cerebro_Python').value(), \{'_CS_ACCION': 'aplicar'\})" +STARTLINE}
 addUserKnob {22 btn_recargar l "Recargar lista OCIO" -STARTLINE T "exec(nuke.thisNode().knob('Cerebro_Python').value(), \{'_CS_ACCION': 'recargar'\})"}
 addUserKnob {26 sep3 l "" +STARTLINE}
 addUserKnob {26 creditos l Créditos T "Samán Estudio SAS. emanuel.barriga@samanestudio.com"}
 addUserKnob {52 Cerebro_Python l "" -STARTLINE +INVISIBLE T "\"\"\"Motor de ColorSpaces autocontenido. Vive embebido en el knob Cerebro_Python\nde ColorSpaces.gizmo.\n\nNo importa nada de SamanTools: el nodo es independiente. Los botones del panel\nejecutan el motor en un namespace PRIVADO (no ensucia __main__):\n\n    exec(nuke.thisNode().knob('Cerebro_Python').value(), \{'_CS_ACCION': 'clasificar'\})\n\nAcciones:\n    clasificar  CLONA los Read reales del grupo del panel en columnas, una por\n                colorspace, cada una con su backdrop CS_BD_*. Los originales\n                conservan posicion, colorspace, file y conexiones.\n    limpiar     borra los clones generados (solo clones seguros) y los\n                backdrops CS_BD_*, nunca un Read real.\n    aplicar     cambia el colorspace de los Read seleccionados (fromScript) y\n                recarga solo los que cambiaron. destino.value() ya es el id.\n    recargar    vuelve a leer la lista OCIO y reconstruye el knob destino.\n    buscar      abre el diálogo modal de búsqueda y aplica al id elegido.\n    init        rellena destino y el estado por defecto (lo llama onCreate).\n\nMenu OCIO jerarquico (S4-13): los values del knob destino son los strings RAW\nde nuke.getOcioColorSpaces() ('id\\\\tlong/name'), la misma forma que guarda\nOCIOColorSpace.in_colorspace; Nuke los renderiza como arbol con submenus y\nknob.value() devuelve el id tecnico. Fallback no-OCIO: values() del knob\ncolorspace de un Read (ids planos, sin submenus).\n\nReglas de clasificacion (S5):\n* Candidatos = Read reales del grupo NO contenidos en un backdrop CS_BD_*\n  (contencion por posicion). Nunca se mueve, recolorspacea, renombra ni\n  conecta un candidato: por columna se seleccionan sus candidatos,\n  nuke.cloneSelected(), y se posicionan los clones (sin tocar su knob name).\n* Todo dentro de UN nuke.Undo() llamado \"Clasificar Reads por colorspace\".\n* Re-correr es idempotente: primero se borra el escaneo anterior (clones\n  seguros dentro de los CS_BD_* + los backdrops).\n\"\"\"\n\nimport re\n\nimport nuke\n\n# ------------------------------------------------------------------ constantes\n_ACCIONES = \{\n    \"clasificar\": \"_clasificar\",\n    \"limpiar\": \"_limpiar\",\n    \"aplicar\": \"_aplicar\",\n    \"buscar\": \"_buscar\",\n    \"recargar\": \"_recargar\",\n    \"init\": \"_init\",\n\}\n\n_PREFIJO_BD = \"CS_BD_\"\n_SIN_COLORSPACE = \"(sin colorspace)\"\n_ESTADO_INICIAL = \"<i>Sin clasificar todavía.</i>\"\n\n_BASE_DX = 260\n_COL_PITCH = 240\n_ROW_PITCH = 120\n\n#: Colores de tile de los backdrops, ciclando por columna.\n_BD_TILES = (0x1c2833ff, 0x14213dff, 0x1e3a2fff, 0x112233ff, 0x2d1e2fff)\n\n\n# ------------------------------------------------------------------ helpers\ndef _knob(nodo, nombre):\n    \"\"\"Knob `nombre` del nodo, o None si no existe (lookup tolerante).\"\"\"\n    return nodo.knobs().get(nombre)\n\n\ndef _value(nodo, nombre, default=None):\n    \"\"\"Valor del knob `nombre`, o `default` si no existe o no se puede leer.\"\"\"\n    knob = _knob(nodo, nombre)\n    if knob is None:\n        return default\n    try:\n        return knob.value()\n    except Exception:\n        return default\n\n\ndef _set(nodo, nombre, valor):\n    \"\"\"setValue tolerante y sin ruido: solo escribe si el knob existe y cambia.\"\"\"\n    knob = _knob(nodo, nombre)\n    if knob is None:\n        return False\n    try:\n        if knob.value() == valor:\n            return False\n    except Exception:\n        pass\n    knob.setValue(valor)\n    return True\n\n\n_TAG_HTML = re.compile(r\"</?(?:span|b|i)\\b\[^>]*>\", re.IGNORECASE)\n\n\ndef _estado(nodo, texto):\n    \"\"\"Escribe `texto` en el knob estado y lo tprinta plano al Script Editor.\n\n    El tprint es best-effort: se eliminan los tags HTML que usamos (span, b, i)\n    y nunca debe lanzar, aunque nuke.tprint no exista o falle.\n    \"\"\"\n    _set(nodo, \"estado\", texto)\n    try:\n        tprint = getattr(nuke, \"tprint\", None)\n        if tprint is None:\n            return\n        plano = _TAG_HTML.sub(\"\", texto)\n        tprint(\"ColorSpaces: %s \[%s]\" % (plano, nodo.fullName()))\n    except Exception:\n        pass\n\n\ndef _contexto(nodo):\n    \"\"\"Grupo donde vive el panel, derivado de su fullName() (nunca guardado).\"\"\"\n    completo = nodo.fullName()\n    if \".\" not in completo:\n        return nuke.root()\n    return nuke.toNode(completo.rsplit(\".\", 1)\[0]) or nuke.root()\n\n\ndef _seleccion(nodo):\n    \"\"\"Selección combinada: contexto ambiente + grupo del panel (S10g).\n\n    Un botón puede correr en un contexto distinto al del panel; se recolecta\n    nuke.selectedNodes() en el contexto ambiente y dentro de with _contexto(nodo),\n    fusionando ambas listas deduplicadas por identidad de nodo.\n    \"\"\"\n    ambiente = list(nuke.selectedNodes())\n    with _contexto(nodo):\n        interno = list(nuke.selectedNodes())\n    vistos = set()\n    fusion = \[]\n    for n in ambiente + interno:\n        if id(n) not in vistos:\n            vistos.add(id(n))\n            fusion.append(n)\n    return fusion\n\n\ndef _reload(nodo):\n    \"\"\"Recarga un Read de forma defensiva (se monkeypatchea en los tests).\"\"\"\n    knob = _knob(nodo, \"reload\")\n    if knob is not None:\n        knob.execute()\n\n\ndef _lista_colores(nodo):\n    \"\"\"Lista raw de espacios: 'id\\\\tlong/name' (OCIO) o values del knob colorspace.\n\n    Preserva cambiar_colorspace.py: nuke.getOcioColorSpaces() primero, y si no\n    está disponible o viene vacío, el fallback no-OCIO son los values del knob\n    colorspace del primer Read del grupo del panel.\n    \"\"\"\n    entradas = None\n    try:\n        entradas = nuke.getOcioColorSpaces()\n    except Exception:\n        entradas = \[]\n    if entradas:\n        return list(entradas)\n    with _contexto(nodo):\n        for nodo_read in nuke.allNodes(\"Read\"):\n            knob = _knob(nodo_read, \"colorspace\")\n            if knob is None:\n                continue\n            try:\n                valores = knob.values()\n            except Exception:\n                valores = \[]\n            if valores:\n                return list(valores)\n    return \[]\n\n\ndef _par_item(item):\n    \"\"\"(id, texto visible) de una entrada: id antes del TAB, texto después.\"\"\"\n    if not isinstance(item, str):\n        item = str(item)\n    if \"\\t\" in item:\n        partes = \[p.strip() for p in item.split(\"\\t\") if p.strip()]\n        if partes:\n            return partes\[0], partes\[-1]\n    valor = item.strip()\n    return valor, valor\n\n\ndef _pares(lista):\n    \"\"\"\[(id, long name)] parseado de la lista raw (OCIO 'id\\\\tlong/name' o ids).\"\"\"\n    pares = \[]\n    for item in lista:\n        _id, nombre = _par_item(item)\n        if _id:\n            pares.append((_id, nombre))\n    return pares\n\n\ndef _resolver_texto(lista, texto):\n    \"\"\"Resuelve `texto` (lo tecleado) al id técnico, con la precedencia de v1.\n\n    Precedencia:\n      1. texto vacío o solo espacios -> None.\n      2. coincidencia exacta (case-sensitive) contra el nombre visible -> id.\n      3. subcadena case-insensitive contra el nombre visible (primer acierto) -> id.\n      4. `texto` es directamente un id técnico -> ese id.\n    Devuelve None si nada resuelve.\n    \"\"\"\n    texto = (texto or \"\").strip()\n    if not texto:\n        return None\n    pares = _pares(lista)\n    for _id, nombre in pares:\n        if nombre == texto:\n            return _id\n    for _id, nombre in pares:\n        if texto.casefold() in nombre.casefold():\n            return _id\n    for _id, nombre in pares:\n        if _id == texto:\n            return _id\n    return None\n\n\ndef _dentro(nodo, backdrop):\n    \"\"\"True si `nodo` cae estrictamente dentro del rectángulo de `backdrop`.\"\"\"\n    return (\n        backdrop.xpos() < nodo.xpos() < backdrop.xpos() + backdrop\[\"bdwidth\"].value()\n        and backdrop.ypos() < nodo.ypos() < backdrop.ypos() + backdrop\[\"bdheight\"].value()\n    )\n\n\ndef _backdrops_cs(nodos):\n    return \[n for n in nodos if n.Class() == \"BackdropNode\"\n            and n.name().startswith(_PREFIJO_BD)]\n\n\ndef _slug(clave):\n    \"\"\"Slug del nombre de backdrop: solo \[A-Za-z0-9_], cada corrida ajena a '_',\n    sin '_' en los extremos, tope 40 chars, 'SIN_ID' si queda vacío.\"\"\"\n    slug = re.sub(r\"\[^A-Za-z0-9_]+\", \"_\", str(clave))\n    slug = slug.strip(\"_\")\n    slug = slug\[:40]\n    return slug if slug else \"SIN_ID\"\n\n\ndef _nombre_unico(base, usados):\n    \"\"\"`base`, o `base_2`, `base_3`, … para resolver colisiones.\"\"\"\n    nombre = base\n    k = 2\n    while nombre in usados:\n        nombre = \"%s_%d\" % (base, k)\n        k += 1\n    usados.add(nombre)\n    return nombre\n\n\ndef _rellenar_destino(nodo, lista_raw):\n    \"\"\"Reconstruye los values del knob destino con los strings RAW (submenus),\n    conservando el valor actual si su id sigue existiendo.\"\"\"\n    knob = _knob(nodo, \"destino\")\n    if knob is None:\n        return\n    actual = _value(nodo, \"destino\")\n    valores = \[]\n    vistos = set()\n    for item in lista_raw:\n        if not isinstance(item, str):\n            item = str(item)\n        if item not in vistos:\n            vistos.add(item)\n            valores.append(item)\n    knob.setValues(valores)\n    ids = \{_id for _id, _nombre in _pares(valores)\}\n    if actual in ids:\n        knob.setValue(actual)\n\n\ndef _borrar_scan(backdrops):\n    \"\"\"Borra los clones seguros dentro de los backdrops CS_BD_* y luego los\n    backdrops. Devuelve (clones_borrados, backdrops_borrados).\"\"\"\n    clones_borrados = 0\n    for bd in backdrops:\n        for nodo in nuke.allNodes(\"Read\"):\n            if (_dentro(nodo, bd) and nodo.clones() > 0\n                    and nodo.inputs() == 0 and not nodo.dependent()):\n                nuke.delete(nodo)\n                clones_borrados += 1\n    for bd in backdrops:\n        nuke.delete(bd)\n    return clones_borrados, len(backdrops)\n\n\n# ------------------------------------------------------------------ acciones\ndef _clasificar(nodo):\n    pares = _pares(_lista_colores(nodo))\n    id_a_nombre = \{_id: nombre for _id, nombre in pares\}\n\n    def etiqueta(clave):\n        return id_a_nombre.get(clave, clave)\n\n    ctx = _contexto(nodo)\n    with ctx:\n        backdrops = _backdrops_cs(nuke.allNodes(\"BackdropNode\"))\n        candidatos = \[\n            r for r in nuke.allNodes(\"Read\")\n            if not any(_dentro(r, bd) for bd in backdrops)\n        ]\n        if not candidatos:\n            _estado(nodo, \"Nada que clasificar\")\n            return None\n\n        grupos = \{\}\n        for read in candidatos:\n            knob = _knob(read, \"colorspace\")\n            clave = _SIN_COLORSPACE if knob is None else knob.value()\n            grupos.setdefault(clave, \[]).append(read)\n\n        orden = _value(nodo, \"orden\")\n        if orden == \"Cantidad\":\n            items = sorted(\n                grupos.items(),\n                key=lambda kv: (-len(kv\[1]), etiqueta(kv\[0]).casefold(), kv\[0]),\n            )\n        else:\n            items = sorted(\n                grupos.items(),\n                key=lambda kv: (etiqueta(kv\[0]).casefold(), kv\[0]),\n            )\n\n        with nuke.Undo():\n            try:\n                nuke.Undo.name(\"Clasificar Reads por colorspace\")\n            except Exception:\n                pass\n\n            _borrar_scan(backdrops)\n\n            base_x = nodo.xpos() + _BASE_DX\n            base_y = nodo.ypos()\n            usados = set()\n\n            for c, (clave, grupo) in enumerate(items):\n                col_x = base_x + c * _COL_PITCH\n\n                for n in nuke.allNodes():\n                    n.setSelected(False)\n                for cand in grupo:\n                    cand.setSelected(True)\n\n                antes = nuke.allNodes(\"Read\")\n                nuke.cloneSelected()\n                clones = \[n for n in nuke.allNodes(\"Read\")\n                          if not any(n is m for m in antes)]\n\n                for i, clone in enumerate(clones):\n                    clone.setXYpos(col_x, base_y + i * _ROW_PITCH)\n\n                lab = etiqueta(clave)\n                count = len(grupo)\n                nombre = _nombre_unico(_PREFIJO_BD + _slug(clave), usados)\n                backdrop = nuke.nodes.BackdropNode(\n                    xpos=col_x - 40,\n                    ypos=base_y - 60,\n                    bdwidth=230,\n                    bdheight=count * _ROW_PITCH + 110,\n                    note_font_size=12,\n                    tile_color=_BD_TILES\[c % len(_BD_TILES)],\n                    label=\"<center><h3>%s</h3><p>%d</p></center>\" % (lab, count),\n                )\n                backdrop.setName(nombre)\n\n        total = len(candidatos)\n        partes = \[\"%s %d\" % (etiqueta(clave), len(grupo)) for clave, grupo in items]\n        resumen = \", \".join(partes\[:6])\n        if len(partes) > 6:\n            resumen += \", …\"\n        _estado(\n            nodo,\n            \"<span style='color:#7fb069'>%d Reads en %d espacios</span>: %s\"\n            % (total, len(items), resumen),\n        )\n    return None\n\n\ndef _limpiar(nodo):\n    ctx = _contexto(nodo)\n    with ctx:\n        backdrops = _backdrops_cs(nuke.allNodes(\"BackdropNode\"))\n        with nuke.Undo():\n            try:\n                nuke.Undo.name(\"Limpiar backdrops ColorSpaces\")\n            except Exception:\n                pass\n            clones_borrados, bd_borrados = _borrar_scan(backdrops)\n    if clones_borrados or bd_borrados:\n        _estado(nodo,\n                \"Se eliminaron %d clones y %d backdrops.\" % (clones_borrados, bd_borrados))\n    else:\n        _estado(nodo, \"No había clones ni backdrops que limpiar.\")\n    return clones_borrados, bd_borrados\n\n\ndef _motivo_corto(exc):\n    \"\"\"Motivo corto de una excepción para el reporte de fallos.\"\"\"\n    texto = str(exc).strip()\n    return texto if texto else type(exc).__name__\n\n\ndef _aplicar_seleccion(nodo, seleccion, id_destino):\n    \"\"\"Aplica id_destino a la selección de forma robusta (S10) y reporta en estado.\n\n    - Deduplica los Read por identidad del knob colorspace (clones cuentan una vez).\n    - Aísla cada Read en try/except (un fallo no aborta el resto).\n    - Reporta los seleccionados que no son Read con colorspace, por nombre/clase.\n    - Todo dentro de UN nuke.Undo() llamado \"Cambiar colorspace\".\n    - Escribe `estado` en `nodo` (el panel), nunca en nuke.thisNode().\n    \"\"\"\n    validos = \[]\n    saltados = \[]\n    for n in seleccion:\n        if n.Class() == \"Read\" and _knob(n, \"colorspace\") is not None:\n            validos.append(n)\n        else:\n            saltados.append(n)\n\n    vistos = set()\n    unicos = \[]\n    clones = 0\n    for read in validos:\n        knob = _knob(read, \"colorspace\")\n        clave = id(knob)\n        if clave in vistos:\n            clones += 1\n        else:\n            vistos.add(clave)\n            unicos.append(read)\n\n    cambiados = 0\n    ya_estaban = 0\n    fallos = \[]\n    with nuke.Undo():\n        try:\n            nuke.Undo.name(\"Cambiar colorspace\")\n        except Exception:\n            pass\n        for read in unicos:\n            try:\n                knob = _knob(read, \"colorspace\")\n                if knob.value() == id_destino:\n                    ya_estaban += 1\n                    continue\n                knob.fromScript(id_destino)\n                _reload(read)\n                cambiados += 1\n            except Exception as exc:\n                fallos.append((read.name(), _motivo_corto(exc)))\n\n    partes = \[]\n    if cambiados:\n        partes.append(\"Se actualizaron %d archivo(s) a %s.\" % (cambiados, id_destino))\n    if ya_estaban:\n        partes.append(\"%d ya estaban en ese espacio.\" % ya_estaban)\n    if clones:\n        partes.append(\"%d nodo(s) son clones del mismo Read y se contaron una vez.\" % clones)\n    if saltados:\n        nombres = \", \".join(\"%s (%s)\" % (n.name(), n.Class()) for n in saltados)\n        partes.append(\n            \"%d seleccionado(s) no son Reads con colorspace: %s.\"\n            % (len(saltados), nombres)\n        )\n    if fallos:\n        detalles = \", \".join(\"%s (%s)\" % (nombre, motivo) for nombre, motivo in fallos)\n        partes.append(\"%d fallaron: %s.\" % (len(fallos), detalles))\n    _estado(nodo, \" \".join(partes))\n    return cambiados, ya_estaban, clones, saltados, fallos\n\n\ndef _aplicar(nodo):\n    seleccion = _seleccion(nodo)\n    validos = \[\n        n for n in seleccion\n        if n.Class() == \"Read\" and _knob(n, \"colorspace\") is not None\n    ]\n    if not validos:\n        _estado(nodo, \"No hay Reads seleccionados.\")\n        return None\n\n    destino_knob = _knob(nodo, \"destino\")\n    valores = destino_knob.values() if destino_knob is not None else \[]\n    id_destino = _value(nodo, \"destino\")\n    if not valores or not id_destino:\n        _estado(nodo, \"No se eligió un espacio de destino.\")\n        return None\n\n    return _aplicar_seleccion(nodo, seleccion, id_destino)\n\n\ndef _recargar(nodo):\n    lista_raw = _lista_colores(nodo)\n    _rellenar_destino(nodo, lista_raw)\n    _estado(\n        nodo,\n        \"<span style='color:#7fb069'>Lista OCIO recargada: %d espacios.</span>\"\n        % len(lista_raw),\n    )\n    return lista_raw\n\n\ndef _crear_selector(lista, parent=None):\n    \"\"\"Fábrica del diálogo modal de búsqueda (Qt importado de forma lazy).\n\n    Devuelve la CLASE del diálogo (sin instanciar, para que sea inspeccionable\n    sin Qt). La instancia se crea con Selector(lista, parent) y expone\n    obtener_seleccion() -> id.\n    \"\"\"\n    try:\n        from PySide2 import QtWidgets, QtCore\n    except ImportError:\n        from PySide6 import QtWidgets, QtCore\n\n    class Selector(QtWidgets.QDialog):\n        def __init__(self, lista, parent=None):\n            super(Selector, self).__init__(parent)\n            self._lista = lista\n            self.setWindowTitle(\"Cambiar Espacio de Color\")\n            self.setMinimumWidth(500)\n            self.setModal(True)\n            self.setWindowFlags(self.windowFlags() | QtCore.Qt.WindowStaysOnTopHint)\n\n            layout = QtWidgets.QVBoxLayout(self)\n            layout.setSpacing(12)\n            layout.setContentsMargins(15, 15, 15, 15)\n\n            etiqueta = QtWidgets.QLabel(\"Buscar y seleccionar espacio de color:\")\n            layout.addWidget(etiqueta)\n\n            self.combo = QtWidgets.QComboBox(self)\n            self.combo.setEditable(True)\n            self.combo.addItem(\"\", None)\n            for item in lista:\n                id_interno, nombre_visible = _par_item(item)\n                self.combo.addItem(nombre_visible, id_interno)\n            self.combo.setCurrentIndex(0)\n\n            completador = self.combo.completer()\n            completador.setFilterMode(QtCore.Qt.MatchContains)\n            completador.setCompletionMode(QtWidgets.QCompleter.PopupCompletion)\n            layout.addWidget(self.combo)\n\n            botones = QtWidgets.QDialogButtonBox(\n                QtWidgets.QDialogButtonBox.Ok | QtWidgets.QDialogButtonBox.Cancel,\n                QtCore.Qt.Horizontal,\n                self,\n            )\n            botones.accepted.connect(self.accept)\n            botones.rejected.connect(self.reject)\n            layout.addWidget(botones)\n\n        def obtener_seleccion(self):\n            return _resolver_texto(self._lista, self.combo.currentText())\n\n    return Selector\n\n\ndef _ejecutar_selector(selector, lista=None):\n    \"\"\"Corre el selector y devuelve el id elegido (o None). Acepta str/None\n    directos (tests headless) o la clase del diálogo, que se instancia con\n    `lista` antes de .exec_().\"\"\"\n    if isinstance(selector, str):\n        return selector\n    if selector is None:\n        return None\n    if isinstance(selector, type):\n        selector = selector(lista)\n    if selector.exec_():\n        return selector.obtener_seleccion()\n    return None\n\n\ndef _set_destino_seguro(nodo, id_destino):\n    \"\"\"setValue del destino tolerante a la validación del knob \{68\}.\"\"\"\n    knob = _knob(nodo, \"destino\")\n    if knob is None:\n        return False\n    try:\n        knob.setValue(id_destino)\n        return True\n    except Exception:\n        return False\n\n\ndef _buscar(nodo):\n    seleccion = _seleccion(nodo)\n    validos = \[\n        n for n in seleccion\n        if n.Class() == \"Read\" and _knob(n, \"colorspace\") is not None\n    ]\n    if not validos:\n        _estado(nodo, \"No hay Reads seleccionados.\")\n        return None\n\n    try:\n        lista = _lista_colores(nodo)\n        selector = _crear_selector(lista, parent=None)\n        id_destino = _ejecutar_selector(selector, lista)\n    except Exception as exc:\n        _estado(\n            nodo,\n            \"<span style='color:#e06c75'><b>%s</b>: %s</span>\"\n            % (type(exc).__name__, exc),\n        )\n        return None\n\n    if not id_destino:\n        _estado(\n            nodo,\n            \"Operación cancelada: No se seleccionó ningún espacio de color válido.\",\n        )\n        return None\n\n    _aplicar_seleccion(nodo, seleccion, id_destino)\n    _set_destino_seguro(nodo, id_destino)\n    return id_destino\n\n\ndef _init(nodo):\n    _rellenar_destino(nodo, _lista_colores(nodo))\n    _estado(nodo, _ESTADO_INICIAL)\n    return None\n\n\ndef colorspaces_engine(accion, nodo=None):\n    \"\"\"Despachador de los botones. No abre diálogos: informa en el knob estado.\"\"\"\n    nodo = nodo or nuke.thisNode()\n    if nodo is None:\n        return None\n    funcion = globals().get(_ACCIONES.get(accion, \"\"))\n    if funcion is None:\n        raise ValueError(\"acción desconocida para ColorSpaces: %r\" % (accion,))\n    try:\n        return funcion(nodo)\n    except Exception as exc:\n        _estado(\n            nodo,\n            \"<span style='color:#e06c75'><b>%s</b>: %s</span>\"\n            % (type(exc).__name__, exc),\n        )\n        raise\n\n\n# Punto de entrada: los botones pasan la acción en el namespace privado del exec.\nif \"_CS_ACCION\" in globals():\n    colorspaces_engine(_CS_ACCION)  # noqa: F821 - inyectada por el exec del botón\n"}
}
