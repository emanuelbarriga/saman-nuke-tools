set cut_paste_input [stack 0]
version 17.1 v3
push 0
push $cut_paste_input
Group {
inputs 2
name Comparacion
tile_color 0x262626ff
label "De dos Elementos"
selected true
xpos 4622
ypos 5163
addUserKnob {20 tab}
addUserKnob {26 text l "" +STARTLINE T " "}
addUserKnob {41 box T Crop1.box}
addUserKnob {41 reset l Reset T Crop1.reset}
addUserKnob {41 reformat -STARTLINE T Crop1.reformat}
addUserKnob {26 text_1 l " "}
addUserKnob {26 text_3 l Comparación T " "}
addUserKnob {22 SidebySide l "Side by Side Horizontal" t "Sets the Switch to input 0" -STARTLINE T nuke.thisNode().node('Switch1').knob('which').setValue(0)}
addUserKnob {22 python_button l "Side by Side Vertical" t "Sets the Switch to input 3" -STARTLINE T nuke.thisNode().node('Switch1').knob('which').setValue(3)}
addUserKnob {26 text_2 l " " T " "}
addUserKnob {26 text_4 l Visualización: T " "}
addUserKnob {22 setInput3 l "Input 1" t "Sets the Switch to input 2" -STARTLINE T nuke.thisNode().node('Switch1').knob('which').setValue(2)}
addUserKnob {22 setInput2 l "Input 2" t "Sets the Switch to input 1" -STARTLINE T nuke.thisNode().node('Switch1').knob('which').setValue(1)}
addUserKnob {22 setDiferente l Diferente t "Sets the Switch to input 4 (Difference)" -STARTLINE T nuke.thisNode().node('Switch1').knob('which').setValue(4)}
addUserKnob {22 swapInputs l "Invertir 1<->2" t "Intercambia la posición de Input 1 e Input 2" -STARTLINE T "g = nuke.thisNode()\nval = 1 - int(g.node('Switch_Swap1').knob('which').value())\ng.node('Switch_Swap1').knob('which').setValue(val)\ng.node('Switch_Swap2').knob('which').setValue(val)"}
addUserKnob {26 creditos l Créditos T "Samán Estudio SAS. emanuel.barriga@samanestudio.com"}
addUserKnob {41 which +INVISIBLE T Switch1.which}
}
Input {
inputs 0
name Input2
xpos 732
ypos 100
number 1
}
set Nddffe300 [stack 0]
Input {
inputs 0
name Input1
xpos 871
ypos 100
}
set Nddffd400 [stack 0]
Switch {
inputs 2
which 1
name Switch_Swap1
xpos 871
ypos 150
}
Crop {
box {0 0 4608 3164}
reformat true
crop false
name Crop1
xpos 871
ypos 223
}
set Cddffde00 [stack 0]
set Nddffde00 [stack 0]
push $Nddffd400
push $Nddffe300
Switch {
inputs 2
which 1
name Switch_Swap2
xpos 732
ypos 150
}
clone $Cddffde00 {
xpos 732
ypos 230
selected false
}
set Ne35e2d00 [stack 0]
Merge2 {
inputs 2
operation difference
name MergeDiff
xpos 1060
ypos 320
}
push $Nddffde00
push $Ne35e2d00
