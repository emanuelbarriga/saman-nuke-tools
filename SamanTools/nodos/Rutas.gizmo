nodo_ver 1
addUserKnob {52 Cerebro_Python l "" -STARTLINE +INVISIBLE T "# Motor de RutasV2 v2 autocontenido. Vive embebido en el knob Cerebro_Python de\n# RutasV2_v2.gizmo y se ejecuta igual que v1:\n#\n#     exec(nuke.thisNode().knob('Cerebro_Python').value()); rutas_engine('...')\n#\n# Entrada estable: rutas_engine(action='sync', arg1=None). Cambios v2 (S10):\n#   (a) el filtro de knobChanged vive en el script del nodo y evita recompilar\n#       el motor al mover/seleccionar el panel;\n#   (b) abrir el panel no reescribe db_json si active_user no cambia, y el\n#       refresco solo escribe knobs cuyo valor cambia;\n#   (c) flag de DB invalida por llamada (no global _RUTAS_DB_BAD);\n#   (d) acceso a knobs seguro ante ausencia;\n#   (e) rebuild_ui hace snapshot antes de borrar y restaura en try/finally,\n#       re-agregando Cerebro_Python como +INVISIBLE;\n#   (f) scan borra clones REV_* obsoletos antes de clonar, con nombres unicos\n#       y un solo undo;\n#   (g) convert precompila regex y calcula bases/tokens una vez por conversion;\n#   (h) kname\[len('folder_'):] en vez de replace;\n#   (i) reload_reads informa los fallos en vez de except: pass.\n#\n# Entrada v2 S11 (estabilidad de variables):\n#   (j) siempre se definen TODOS los PYTHON_* que el script referencia, aunque\n#       la db no los tenga: un nombre ausente imprime NameError y deja el knob\n#       con el texto del error en vez de la ruta;\n#   (k) addOnScriptLoad + onCreate dejan el namespace listo y reload_reads\n#       limpia el error cacheado del knob, asi que reabrir con muchas fuentes\n#       no vuelve a romper nada;\n#   (l) ninguna accion propaga excepciones: un db_json roto o una estructura\n#       invalida se informa en el panel y el proyecto sigue abriendo.\n\nimport nuke\nimport os\nimport re\nimport json\nimport __main__\n\n# S11: Nuke evalúa \[python \{PYTHON_X\}] con el diccionario de __main__. Si el\n# nombre no existe, imprime el NameError y deja ese knob con el texto del\n# error (nuke.filename() devuelve el error en vez de la ruta). Con muchas\n# fuentes el rastro se multiplica y el proyecto queda con rutas rotas.\nRE_VAR_REF = re.compile(r'\\\[python\\s*\\\{\\s*(PYTHON_\[A-Za-z0-9_]*)')\nVARS_CAP = ('PYTHON_CAP', 'PYTHON_CAP_DIR', 'PYTHON_CAP_NUM')\n\n\ndef _reportar(mensaje):\n    \"\"\"Avisa sin traceback: primero en el panel, si no hay, una linea.\"\"\"\n    texto = '\[RutasV2] ' + mensaje\n    nodo = None\n    try:\n        nodo = nuke.thisNode()\n    except Exception:\n        nodo = None\n    for vname in ('db_json_view', 'db_json_1'):\n        k = nodo.knob(vname) if nodo else None\n        if k is not None:\n            try:\n                k.setValue(texto)\n                return\n            except Exception:\n                break\n    try:\n        print(texto)\n    except Exception:\n        pass\n\n\ndef _definir_var(nombre, valor):\n    \"\"\"Define nombre en __main__/nuke/os.environ/tcl. Devuelve si faltaba.\"\"\"\n    if not nombre or not isinstance(nombre, str):\n        return False\n    falta = not hasattr(__main__, nombre)\n    for target in (__main__, nuke):\n        try:\n            setattr(target, nombre, valor)\n        except Exception:\n            pass\n    try:\n        os.environ\[nombre] = valor\n    except Exception:\n        pass\n    try:\n        nuke.tcl('set', nombre, valor)\n    except Exception:\n        pass\n    return falta\n\n\ndef _nodos_del_script():\n    \"\"\"Todos los nodos del script, incluyendo los de grupos anidados.\n\n    nuke.allNodes() depende del contexto actual: ejecutado desde el panel\n    devuelve solo el contenido del grupo, que es exactamente donde NO estan\n    las fuentes que hay que revisar.\n    \"\"\"\n    out = list()\n    pendientes = \[nuke.root()]\n    while pendientes:\n        grupo = pendientes.pop(0)\n        try:\n            hijos = grupo.nodes()\n        except Exception:\n            hijos = list()\n        for n in hijos:\n            out.append(n)\n            try:\n                if n.Class() == 'Group':\n                    pendientes.append(n)\n            except Exception:\n                pass\n    return out\n\n\ndef _nombres_referenciados():\n    \"\"\"PYTHON_* que alguna ruta \[python \{...\}] del script necesita.\"\"\"\n    nombres = set()\n    try:\n        nodos = _nodos_del_script()\n    except Exception:\n        return nombres\n    for n in nodos:\n        try:\n            k = n.knob('file')\n        except Exception:\n            k = None\n        if k is None:\n            continue\n        try:\n            texto = str(k.value() or '')\n        except Exception:\n            texto = ''\n        if 'python' not in texto.lower():\n            continue\n        for m in RE_VAR_REF.finditer(texto):\n            nombres.add(m.group(1))\n    return nombres\n\n\ndef _cap_de_panel(nodo):\n    \"\"\"Capitulo configurado, saneado; '' si Caps esta apagado.\"\"\"\n    if nodo is None:\n        return ''\n    k_bool = nodo.knob('boolean')\n    k_cap = nodo.knob('cap_actual')\n    if k_bool is None or k_cap is None:\n        return ''\n    try:\n        if not k_bool.value():\n            return ''\n        limpio = ''\n        for c in str(k_cap.value() or '').strip():\n            if c.isascii() and (c.isalnum() or c in ('_', '-')):\n                limpio += c\n        if not limpio or limpio.startswith('.'):\n            return ''\n        return limpio\n    except Exception:\n        return ''\n\n\ndef _normalizar_db(data):\n    \"\"\"Devuelve (db usable, quedo_sana). No modifica la entrada.\"\"\"\n    if not isinstance(data, dict):\n        return dict(active_user='', folders=list(), users=dict()), False\n    sana = True\n    folders = data.get('folders', list())\n    if not isinstance(folders, list):\n        folders, sana = list(), False\n    folders_ok = list()\n    for f in folders:\n        if not isinstance(f, dict) or not isinstance(f.get('id'), str) or not f.get('id').strip():\n            sana = False\n            continue\n        folders_ok.append(f)\n    users = data.get('users', dict())\n    if not isinstance(users, dict):\n        users, sana = dict(), False\n    users_ok = dict()\n    for u, p in users.items():\n        if not isinstance(p, dict):\n            sana = False\n            continue\n        users_ok\[str(u)] = dict((str(k), v if isinstance(v, str) else '') for k, v in p.items())\n    out = dict(data)\n    out\['folders'] = folders_ok\n    out\['users'] = users_ok\n    out.setdefault('active_user', '')\n    return out, sana\n\n\ndef _vars_de_panel(nodo):\n    \"\"\"nombre -> valor segun el db_json y los knobs del panel. Tolerante.\"\"\"\n    valores = dict()\n    data = dict()\n    k_db = nodo.knob('db_json') if nodo else None\n    if k_db is not None:\n        try:\n            data = _normalizar_db(json.loads(k_db.value() or ''))\[0]\n        except Exception:\n            data = dict(active_user='', folders=list(), users=dict())\n    k_user = nodo.knob('pulldown') if nodo else None\n    user = data.get('active_user', '')\n    if k_user is not None:\n        try:\n            user = k_user.value()\n        except Exception:\n            pass\n    u_paths = data.get('users', dict()).get(user, dict())\n    for f in data.get('folders', list()):\n        valores\['PYTHON_' + f\['id'].upper()] = str(u_paths.get(f\['id'], '') or '')\n    cap = _cap_de_panel(nodo)\n    valores\['PYTHON_CAP'] = cap\n    valores\['PYTHON_CAP_DIR'] = (cap + '/') if cap else ''\n    valores\['PYTHON_CAP_NUM'] = ''.join(c for c in cap if c.isdigit())\n    return valores\n\n\ndef _bootstrap_script():\n    \"\"\"Define los PYTHON_* del script sin depender de un panel concreto.\"\"\"\n    definidas = list()\n    try:\n        nodos = _nodos_del_script()\n    except Exception:\n        nodos = list()\n    valores = dict()\n    for n in nodos:\n        try:\n            tiene_db = n.knob('db_json') is not None\n        except Exception:\n            tiene_db = False\n        if tiene_db:\n            valores.update(_vars_de_panel(n))\n    for nombre in _nombres_referenciados():\n        if nombre in VARS_CAP:\n            continue\n        valores.setdefault(nombre, '')\n    for nombre in sorted(valores):\n        if _definir_var(nombre, valores\[nombre]):\n            definidas.append(nombre)\n    return definidas\n\n\ndef _instalar_hooks():\n    \"\"\"Una sola vez por proceso: reabastece el namespace al cargar un script.\"\"\"\n    if getattr(__main__, '_RUTAS_HOOKS_V2', False):\n        return\n    setattr(__main__, '_RUTAS_HOOKS_V2', True)\n\n    def _al_cargar_script():\n        try:\n            _bootstrap_script()\n        except Exception:\n            pass\n\n    try:\n        nuke.addOnScriptLoad(_al_cargar_script)\n    except Exception:\n        pass\n\n\ndef rutas_engine(action='sync', arg1=None):\n    # S11l: onCreate y knobChanged entran por aca. Ninguna accion propaga una\n    # excepcion: un db_json roto tiene que informarse, no romper la apertura.\n    try:\n        _instalar_hooks()\n        return _rutas_engine(action, arg1)\n    except Exception as exc:\n        _reportar('rutas_engine(' + repr(action) + ') fallo: ' + type(exc).__name__ + ': ' + str(exc))\n        return None\n\n\ndef _rutas_engine(action='sync', arg1=None):\n    nodo = nuke.thisNode()\n    if not nodo or not nodo.knob('db_json'):\n        return\n\n    parts = nodo.fullName().split('.')\n    parent_ctx = nuke.toNode('.'.join(parts\[:-1])) if len(parts) > 1 else nuke.root()\n    NL = chr(10)\n    DQ = chr(34)\n    BS = chr(92)\n    LB = chr(91)\n    RB = chr(93)\n    LC = chr(123)\n    RC = chr(125)\n\n    # S10c: la validez de la DB es de esta llamada, no un flag global de proceso.\n    db_valid = True\n\n    def _knob(name):\n        return nodo.knob(name) if nodo else None\n\n    def _value(name, default=''):\n        k = _knob(name)\n        return k.value() if k is not None else default\n\n    def json_view_set(texto):\n        for vname in ('db_json_view', 'db_json_1'):\n            vk = _knob(vname)\n            if vk is not None:\n                try:\n                    vk.setValue(texto)\n                except Exception:\n                    pass\n                return True\n        return False\n\n    def load_db():\n        nonlocal db_valid\n        k = _knob('db_json')\n        raw = k.value() if k is not None else ''\n        try:\n            crudo = json.loads(raw)\n        except Exception:\n            db_valid = False\n            if raw.strip():\n                json_view_set('JSON invalido: revisa el knob db_json. El texto guardado no se modifico.')\n            return _normalizar_db(dict(active_user='Mac'))\[0]\n        data, sana = _normalizar_db(crudo)\n        db_valid = sana\n        if not sana and raw.strip():\n            # S11l: la db existe pero tiene tipos inesperados (folders/users).\n            json_view_set('JSON invalido: folders/users traen datos inutilizables. El texto guardado no se modifico.')\n        return data\n\n    def show_db(data):\n        if not db_valid:\n            return\n        json_view_set(json.dumps(data, indent=2))\n\n    def save_db(data):\n        nonlocal db_valid\n        texto = json.dumps(data, indent=2)\n        k = _knob('db_json')\n        if k is not None:\n            k.setValue(texto)\n        db_valid = True\n        json_view_set(texto)\n\n    def show_panel(target):\n        if not target:\n            return False\n        try:\n            nuke.show(target, forceFloat=True)\n            return True\n        except Exception:\n            pass\n        try:\n            target.showControlPanel(True)\n            return True\n        except Exception:\n            return False\n\n    def cap_configurado():\n        return _cap_de_panel(nodo)\n\n    def push_env(data):\n        # S11j: se define todo lo que el script necesita, no solo lo que la db\n        # conoce. Un PYTHON_* ausente deja el Read con el texto del NameError.\n        user = _value('pulldown')\n        u_paths = data.get('users', dict()).get(user, dict())\n        definidas = list()\n        en_db = set()\n        for f in data.get('folders', list()):\n            fid = f.get('id', '')\n            if not fid:\n                continue\n            nombre = 'PYTHON_' + str(fid).upper()\n            en_db.add(nombre)\n            valor = u_paths.get(fid, '')\n            if _definir_var(nombre, valor if isinstance(valor, str) else ''):\n                definidas.append(nombre)\n        cap_val = cap_configurado()\n        cap_dir = (cap_val + '/') if cap_val else ''\n        cap_num = ''.join(c for c in cap_val if c.isdigit())\n        for nombre, valor in (('PYTHON_CAP', cap_val), ('PYTHON_CAP_DIR', cap_dir), ('PYTHON_CAP_NUM', cap_num)):\n            en_db.add(nombre)\n            if _definir_var(nombre, valor):\n                definidas.append(nombre)\n        protegidas = list()\n        for nombre in sorted(_nombres_referenciados()):\n            if nombre in en_db or nombre.startswith('PYTHON_CAP'):\n                continue\n            # S12a: nombre que la db no lista. Se define '' solo si nadie lo\n            # definio ya (otro panel u otra herramienta manda), para que la\n            # fuente no quede en NameError; queda reportado en el panel.\n            if not hasattr(__main__, nombre):\n                _definir_var(nombre, '')\n            if nombre not in protegidas:\n                protegidas.append(nombre)\n        return dict(definidas=definidas, protegidas=protegidas)\n\n    def avisar_protegidas(protegidas):\n        # S12: el aviso vive en el panel (Backend); no depende de instalar nada\n        # y reemplaza a la vista JSON mientras haya variables sin definir.\n        if not protegidas:\n            return False\n        aviso = (\n            'Aviso: ' + str(len(protegidas)) + ' variable(s) de ruta no estan en el JSON y se protegieron con \"\"'\n            ' (sin NameError): ' + ', '.join(protegidas) + '.' + NL\n            + 'Revisa las carpetas del panel o el JSON, y usa Recargar Reads para reparar las fuentes.'\n        )\n        if not db_valid:\n            # Ya hay un diagnostico del JSON en la vista: no lo tapamos.\n            previo = ''\n            for vname in ('db_json_view', 'db_json_1'):\n                vk = _knob(vname)\n                if vk is not None:\n                    try:\n                        previo = str(vk.value() or '')\n                    except Exception:\n                        previo = ''\n                    break\n            if previo:\n                aviso = previo + NL + aviso\n        json_view_set(aviso)\n        return True\n\n    def refresh_ui_values(data):\n        user = _value('pulldown')\n        u_paths = data.get('users', dict()).get(user, dict())\n        for f in data.get('folders', list()):\n            kname = f.get('knob', '')\n            k = _knob(kname) if kname else None\n            if k is not None:\n                val = u_paths.get(f.get('id', ''), '')\n                # S10b: solo escribir cuando cambia, para no ensuciar el script.\n                if k.value() != val:\n                    k.setValue(val)\n        cap_k = _knob('cap_actual')\n        bool_k = _knob('boolean')\n        if cap_k is not None and bool_k is not None:\n            visible = bool(bool_k.value())\n            if bool(cap_k.getFlag(nuke.INVISIBLE)) == visible:\n                cap_k.setVisible(visible)\n\n    def rebuild_ui(data):\n        # S10e: snapshot ANTES de borrar; el remove+add completo va en try/finally\n        # para que Cerebro_Python y db_json siempre vuelvan a existir.\n        code = _value('Cerebro_Python')\n        raw_json = _value('db_json')\n        names = list(nodo.knobs().keys())\n        try:\n            if 'text_4' in names:\n                for k in names\[names.index('text_4') + 1:]:\n                    kk = _knob(k)\n                    if kk is not None:\n                        nodo.removeKnob(kk)\n\n            curr_user = _value('pulldown')\n            u_paths = data.get('users', dict()).get(curr_user, dict())\n\n            for f in data.get('folders', list()):\n                fid = f.get('id', '')\n                kname = f.get('knob', 'folder_' + fid)\n                lbl = f.get('label', fid)\n                nk = nuke.File_Knob(kname, lbl)\n                nk.setValue(u_paths.get(fid, ''))\n                nodo.addKnob(nk)\n                cmd_del = 'exec(nuke.thisNode().knob(' + repr('Cerebro_Python') + ').value()); rutas_engine(' + repr('del_folder') + ', ' + repr(fid) + ')'\n                bx = nuke.PyScript_Knob('btn_del_fldr_' + fid, chr(215), cmd_del)\n                bx.clearFlag(nuke.STARTLINE)\n                nodo.addKnob(bx)\n\n            cmd_add_f = 'exec(nuke.thisNode().knob(' + repr('Cerebro_Python') + ').value()); rutas_engine(' + repr('add_folder') + ')'\n            b_add = nuke.PyScript_Knob('btn_add_folder', 'Agregar Carpeta', cmd_add_f)\n            b_add.setFlag(nuke.STARTLINE)\n            nodo.addKnob(b_add)\n\n            nodo.addKnob(nuke.Text_Knob('text_1', ' ', '  '))\n            nodo.addKnob(nuke.Text_Knob('text_4_1', 'Escaneo Reads', ' '))\n            b_sr1 = nuke.PyScript_Knob('btn_scan_reads', 'Identificar sin Rutas Relativas', 'exec(nuke.thisNode().knob(' + repr('Cerebro_Python') + ').value()); rutas_engine(' + repr('scan_reads') + ')')\n            b_sr1.clearFlag(nuke.STARTLINE)\n            nodo.addKnob(b_sr1)\n            b_sr2 = nuke.PyScript_Knob('btn_conv_reads', 'Convertir a Rutas Relativas', 'exec(nuke.thisNode().knob(' + repr('Cerebro_Python') + ').value()); rutas_engine(' + repr('convert_reads') + ')')\n            b_sr2.clearFlag(nuke.STARTLINE)\n            nodo.addKnob(b_sr2)\n\n            nodo.addKnob(nuke.Text_Knob('text_4_1_1', 'Escaneo Writes', ' '))\n            b_sw1 = nuke.PyScript_Knob('btn_scan_writes', 'Identificar sin Rutas Relativas', 'exec(nuke.thisNode().knob(' + repr('Cerebro_Python') + ').value()); rutas_engine(' + repr('scan_writes') + ')')\n            b_sw1.clearFlag(nuke.STARTLINE)\n            nodo.addKnob(b_sw1)\n            b_sw2 = nuke.PyScript_Knob('btn_conv_writes', 'Convertir a Rutas Relativas', 'exec(nuke.thisNode().knob(' + repr('Cerebro_Python') + ').value()); rutas_engine(' + repr('convert_writes') + ')')\n            b_sw2.clearFlag(nuke.STARTLINE)\n            nodo.addKnob(b_sw2)\n\n            nodo.addKnob(nuke.Text_Knob('text_1_1', ' ', '  '))\n            nodo.addKnob(nuke.Text_Knob('TiposG', 'Set de Writes', ' '))\n\n            with nodo:\n                internal_writes = sorted(nuke.allNodes('Write'), key=lambda x: x.xpos())\n            for w in internal_writes:\n                wn = w.name()\n                wl = w.knob('label')\n                lbl = (wl.value().strip() if wl is not None else '') or wn\n                bw = nuke.PyScript_Knob('btn_w_' + wn, lbl, 'exec(nuke.thisNode().knob(' + repr('Cerebro_Python') + ').value()); rutas_engine(' + repr('copy_write') + ', ' + repr(wn) + ')')\n                bw.setFlag(nuke.STARTLINE)\n                nodo.addKnob(bw)\n                be = nuke.PyScript_Knob('btn_we_' + wn, chr(9998), 'exec(nuke.thisNode().knob(' + repr('Cerebro_Python') + ').value()); rutas_engine(' + repr('edit_write') + ', ' + repr(wn) + ')')\n                be.clearFlag(nuke.STARTLINE)\n                nodo.addKnob(be)\n                bd = nuke.PyScript_Knob('btn_wd_' + wn, chr(215), 'exec(nuke.thisNode().knob(' + repr('Cerebro_Python') + ').value()); rutas_engine(' + repr('del_write') + ', ' + repr(wn) + ')')\n                bd.clearFlag(nuke.STARTLINE)\n                nodo.addKnob(bd)\n\n            bnw = nuke.PyScript_Knob('btn_add_write', 'Nuevo Write', 'exec(nuke.thisNode().knob(' + repr('Cerebro_Python') + ').value()); rutas_engine(' + repr('add_write') + ')')\n            bnw.setFlag(nuke.STARTLINE)\n            nodo.addKnob(bnw)\n        finally:\n            if not _knob('Backend'):\n                nodo.addKnob(nuke.Tab_Knob('Backend'))\n            if not _knob('db_json_view') and not _knob('db_json_1'):\n                nodo.addKnob(nuke.Text_Knob('db_json_view', 'Base de Datos JSON', ' '))\n            if not _knob('db_json'):\n                k_db = nuke.EvalString_Knob('db_json', 'JSON crudo (editable)')\n                k_db.setValue(raw_json)\n                k_db.setFlag(nuke.STARTLINE)\n                nodo.addKnob(k_db)\n            if not _knob('Cerebro_Python'):\n                k_py = nuke.PythonCustomKnob('Cerebro_Python', '')\n                k_py.setValue(code)\n                k_py.clearFlag(nuke.STARTLINE)\n                k_py.setFlag(nuke.INVISIBLE)  # S10e: Cerebro_Python +INVISIBLE\n                nodo.addKnob(k_py)\n            show_db(data)\n\n    if action == 'sync':\n        if getattr(__main__, '_RUTAS_BUSY', False):\n            return\n        try:\n            __main__._RUTAS_BUSY = True\n            data = load_db()\n            refresh_ui_values(data)\n            show_db(data)\n            info = push_env(data)\n            avisar_protegidas(info.get('protegidas', list()))\n        finally:\n            __main__._RUTAS_BUSY = False\n        return\n\n    if action == 'knob_changed':\n        if getattr(__main__, '_RUTAS_BUSY', False):\n            return\n        k = nuke.thisKnob()\n        if not k:\n            return\n        kname = k.name()\n        try:\n            __main__._RUTAS_BUSY = True\n            data = load_db()\n            if kname == 'showPanel':\n                # S10b: solo persistir si el usuario activo cambio de verdad.\n                new_user = _value('pulldown')\n                if data.get('active_user') != new_user:\n                    data\['active_user'] = new_user\n                    save_db(data)\n                refresh_ui_values(data)\n                avisar_protegidas(push_env(data).get('protegidas', list()))\n            elif kname == 'pulldown':\n                data\['active_user'] = _value('pulldown')\n                refresh_ui_values(data)\n                save_db(data)\n                avisar_protegidas(push_env(data).get('protegidas', list()))\n            elif kname in ('boolean', 'cap_actual'):\n                cap_k = _knob('cap_actual')\n                bool_k = _knob('boolean')\n                if cap_k is not None and bool_k is not None:\n                    cap_k.setVisible(bool(bool_k.value()))\n                push_env(data)\n            elif kname.startswith('folder_'):\n                user = _value('pulldown')\n                kk = _knob(kname)\n                val = (kk.value() if kk is not None else '').replace(BS, '/')\n                if val and not val.endswith('/'):\n                    val += '/'\n                    if kk is not None:\n                        kk.setValue(val)\n                fid = kname\[len('folder_'):]  # S10h\n                data.setdefault('users', dict()).setdefault(user, dict()).__setitem__(fid, val)\n                save_db(data)\n                push_env(data)\n            elif kname == 'db_json':\n                show_db(data)\n        finally:\n            __main__._RUTAS_BUSY = False\n        return\n\n    if action == 'add_folder':\n        data = load_db()\n        p = nuke.Panel('Agregar Nueva Carpeta Global')\n        p.addSingleLineInput('Etiqueta visible (ej. 3D Renders):', '')\n        p.addSingleLineInput('Variable (ej. 3D -> PYTHON_3D):', '')\n        p.addFilenameSearch('Ruta para usuario actual:', '')\n        if not p.show():\n            return\n        lbl = p.value('Etiqueta visible (ej. 3D Renders):').strip()\n        raw_var = p.value('Variable (ej. 3D -> PYTHON_3D):').strip().upper().replace('PYTHON_', '')\n        fid = ''.join(c if (c.isalnum() or c == '_') else '_' for c in raw_var).strip('_')\n        ruta_nueva = (p.value('Ruta para usuario actual:') or '').strip().replace(BS, '/')\n        if ruta_nueva and not ruta_nueva.endswith('/'):\n            ruta_nueva += '/'\n        if not lbl or not fid:\n            nuke.message('Debes indicar etiqueta y nombre de variable.')\n            return\n        kname = 'folder_' + fid\n        if _knob(kname):\n            nuke.message('La variable PYTHON_' + fid + ' ya existe.')\n            return\n        curr_u = _value('pulldown')\n        data.setdefault('folders', list()).append(dict(id=fid, label=lbl, knob=kname))\n        for u in data.get('users', dict()):\n            u_dict = data.get('users').get(u)\n            if u == curr_u:\n                u_dict.__setitem__(fid, ruta_nueva)\n            else:\n                ref = u_dict.get('COMP', '')\n                base_dir = ref\[:-5] if ref.endswith('COMP/') else ref\n                u_dict.__setitem__(fid, base_dir + fid + '/')\n        try:\n            __main__._RUTAS_BUSY = True\n            save_db(data)\n            rebuild_ui(data)\n            push_env(data)\n        finally:\n            __main__._RUTAS_BUSY = False\n        nuke.message('Carpeta agregada.' + NL + 'Variable: ' + LB + 'python ' + LC + 'PYTHON_' + fid + RC + RB)\n        return\n\n    if action == 'del_folder':\n        if not arg1:\n            return\n        if nuke.ask('Eliminar la carpeta ' + arg1 + ' de todos los usuarios?'):\n            data = load_db()\n            data.__setitem__('folders', list(f for f in data.get('folders', list()) if f.get('id') != arg1))\n            for u_dict in data.get('users', dict()).values():\n                u_dict.pop(arg1, None)\n            try:\n                __main__._RUTAS_BUSY = True\n                save_db(data)\n                rebuild_ui(data)\n                push_env(data)\n            finally:\n                __main__._RUTAS_BUSY = False\n        return\n\n    if action == 'add_write':\n        data = load_db()\n        f_ids = list(f.get('id') for f in data.get('folders', list())) or list(('COMP', 'FROM_VFX'))\n        if 'FROM_VFX' in f_ids:\n            f_ids.remove('FROM_VFX')\n            f_ids.insert(0, 'FROM_VFX')\n        p = nuke.Panel('Nuevo Preset de Write')\n        p.addSingleLineInput('Nombre Interno (ej. Write_Matte):', 'Write_Nuevo')\n        p.addSingleLineInput('Etiqueta Boton (ej. Matte):', 'Matte')\n        p.addEnumerationPulldown('Carpeta Base:', ' '.join(f_ids))\n        p.addSingleLineInput('Subcarpeta y Archivo:', 'MATTE/' + LB + 'file rootname ' + LB + 'file tail ' + LB + 'value root.name' + RB + RB + RB + '_matte.####.exr')\n        if not p.show():\n            return\n        wn = p.value('Nombre Interno (ej. Write_Matte):').strip().replace(' ', '_')\n        lbl = p.value('Etiqueta Boton (ej. Matte):').strip() or wn\n        base_f = p.value('Carpeta Base:')\n        sub_f = p.value('Subcarpeta y Archivo:').strip().lstrip('/')\n        if not wn:\n            return\n        with nodo:\n            if nuke.exists(wn):\n                nuke.message('Ya existe un Write interno con ese nombre.')\n                return\n            max_x = max(list(n.xpos() for n in nuke.allNodes('Write')) or list((0,)))\n            w = nuke.nodes.Write(name=wn, label=lbl, xpos=max_x + 150, ypos=102)\n            w.knob('create_directories').setValue(True)\n            ruta_w = LB + 'python ' + LC + 'PYTHON_' + base_f + RC + RB + '/' + LB + 'python ' + LC + 'PYTHON_CAP_DIR' + RC + RB + sub_f\n            w.knob('file').setValue(ruta_w)\n        try:\n            __main__._RUTAS_BUSY = True\n            rebuild_ui(data)\n        finally:\n            __main__._RUTAS_BUSY = False\n        nuevo = None\n        with nodo:\n            if nuke.exists(wn):\n                nuevo = nuke.toNode(wn)\n        if not show_panel(nuevo):\n            nuke.message('Write ' + wn + ' creado. Abri el grupo para editar sus propiedades.')\n        return\n\n    if action == 'del_write':\n        if not arg1:\n            return\n        if nuke.ask('Eliminar el preset de Write: ' + arg1 + '?'):\n            with nodo:\n                if nuke.exists(arg1):\n                    nuke.delete(nuke.toNode(arg1))\n            try:\n                __main__._RUTAS_BUSY = True\n                rebuild_ui(load_db())\n            finally:\n                __main__._RUTAS_BUSY = False\n        return\n\n    if action == 'edit_write':\n        if not arg1:\n            return\n        target = None\n        with nodo:\n            if nuke.exists(arg1):\n                target = nuke.toNode(arg1)\n        if not target:\n            nuke.message('No existe el preset de Write ' + arg1 + ' dentro del grupo.')\n            return\n        if not show_panel(target):\n            nuke.message('No se pudo abrir el panel de ' + arg1 + '.')\n        return\n\n    if action == 'copy_write':\n        if not arg1:\n            return\n        k_script = ''\n        lbl_src = ''\n        lbl_w = arg1\n        with nodo:\n            w = nuke.toNode(arg1)\n            if w:\n                k_script = w.writeKnobs(nuke.TO_SCRIPT)\n                wl = w.knob('label')\n                lbl_src = wl.value().strip() if wl is not None else ''\n                lbl_w = lbl_src or arg1\n        if not k_script:\n            nuke.message('No existe el preset de Write ' + arg1 + ' dentro del grupo.')\n            return\n        with parent_ctx:\n            sel = nuke.selectedNodes()\n            parent = sel\[0] if sel else None\n            nombre = arg1\n            sufijo = 1\n            while nuke.exists(nombre):\n                sufijo += 1\n                nombre = arg1 + str(sufijo)\n            with nuke.Undo():\n                nuke.Undo.name('Crear Write ' + lbl_w)\n                for x in nuke.allNodes():\n                    x.setSelected(False)\n                nw = nuke.createNode('Write', inpanel=False)\n                nw.readKnobs(k_script)\n                nw.knob('name').setValue(nombre)\n                if lbl_src:\n                    nw.knob('label').setValue(lbl_src)\n                if parent:\n                    nw.setInput(0, parent)\n                    nw.setXYpos(parent.xpos(), parent.ypos() + 90)\n                else:\n                    nw.setXYpos(nodo.xpos(), nodo.ypos() + 140)\n                nw.setSelected(True)\n        return\n\n    if action == 'replace_project':\n        old_p = _value('proyecto').strip()\n        new_p = _value('proyecto_nuevo').strip()\n        if not old_p or not new_p or old_p == new_p:\n            nuke.message('Verifica que Proyecto y el campo de reemplazo tengan textos distintos.')\n            return\n        data = load_db()\n        reemplazos = 0\n        for u_dict in data.get('users', dict()).values():\n            for fid, ruta in list(u_dict.items()):\n                if old_p in ruta:\n                    u_dict.__setitem__(fid, ruta.replace(old_p, new_p))\n                    reemplazos += 1\n        try:\n            __main__._RUTAS_BUSY = True\n            pk = _knob('proyecto')\n            if pk is not None:\n                pk.setValue(new_p)\n            save_db(data)\n            refresh_ui_values(data)\n            push_env(data)\n        finally:\n            __main__._RUTAS_BUSY = False\n        nuke.message('Se reemplazo ' + DQ + old_p + DQ + ' por ' + DQ + new_p + DQ + ' en ' + str(reemplazos) + ' rutas.')\n        return\n\n    if action == 'new_user':\n        data = load_db()\n        uex = list(data.get('users', dict()).keys())\n        curr_u = _value('pulldown')\n        if curr_u in uex:\n            uex.remove(curr_u)\n            uex.insert(0, curr_u)\n        p = nuke.Panel('Crear Nuevo Usuario')\n        p.addSingleLineInput('Nombre del Usuario:', '')\n        p.addEnumerationPulldown('Copiar rutas base de:', ' '.join(uex))\n        if not p.show():\n            return\n        nu = p.value('Nombre del Usuario:').strip().replace(' ', '_')\n        bu = p.value('Copiar rutas base de:')\n        if not nu or nu in data.get('users', dict()):\n            nuke.message('Nombre invalido o el usuario ya existe.')\n            return\n        data.setdefault('users', dict()).__setitem__(nu, dict(data.get('users', dict()).get(bu, dict())))\n        data.__setitem__('active_user', nu)\n        try:\n            __main__._RUTAS_BUSY = True\n            save_db(data)\n            pk = _knob('pulldown')\n            if pk is not None:\n                pk.setValues(list(data.get('users').keys()))\n                pk.setValue(nu)\n            refresh_ui_values(data)\n            push_env(data)\n        finally:\n            __main__._RUTAS_BUSY = False\n        nuke.message('Usuario creado: ' + nu)\n        return\n\n    if action == 'del_user':\n        data = load_db()\n        usuarios = list(data.get('users', dict()).keys())\n        if len(usuarios) <= 1:\n            nuke.message('Debe quedar al menos un usuario configurado.')\n            return\n        p = nuke.Panel('Eliminar Usuario')\n        p.addEnumerationPulldown('Usuario a eliminar:', ' '.join(usuarios))\n        if not p.show():\n            return\n        u_del = p.value('Usuario a eliminar:')\n        if u_del not in usuarios:\n            nuke.message('Usuario no valido: ' + u_del)\n            return\n        if not nuke.ask('Eliminar el usuario ' + u_del + ' y sus rutas guardadas?'):\n            return\n        data.get('users', dict()).pop(u_del, None)\n        restantes = list(data.get('users', dict()).keys())\n        if data.get('active_user') == u_del:\n            data.__setitem__('active_user', restantes\[0])\n        try:\n            __main__._RUTAS_BUSY = True\n            save_db(data)\n            pk = _knob('pulldown')\n            if pk is not None:\n                pk.setValues(restantes)\n                pk.setValue(data.get('active_user'))\n            refresh_ui_values(data)\n            push_env(data)\n        finally:\n            __main__._RUTAS_BUSY = False\n        nuke.message('Usuario eliminado: ' + u_del)\n        return\n\n    if action == 'reload_reads':\n        # S11k: reabastecer variables y limpiar el NameError cacheado de cada\n        # Read antes de recargar. El valor del knob no se reescribe.\n        data = load_db()\n        info = push_env(data)\n        definidas = info.get('definidas', list())\n        with parent_ctx:\n            reads = nuke.allNodes('Read')\n            recargados = 0\n            refrescadas = list()\n            sin_resolver = list()\n            fallos = list()\n            for r in reads:\n                k = r.knob('file')\n                if k is not None:\n                    try:\n                        valor = k.value()\n                    except Exception:\n                        valor = ''\n                    if valor and LB in str(valor):\n                        try:\n                            if 'is not defined' in str(k.evaluate()):\n                                k.setValue('')\n                                k.setValue(valor)\n                                if 'is not defined' in str(k.evaluate()):\n                                    sin_resolver.append(r.name())\n                                else:\n                                    refrescadas.append(r.name())\n                        except Exception:\n                            sin_resolver.append(r.name())\n                k_reload = r.knob('reload')\n                if k_reload is None:\n                    continue\n                try:\n                    k_reload.execute()\n                    recargados += 1\n                except Exception as e:\n                    # S10i: informar los fallos en vez de silenciarlos.\n                    fallos.append((r.name(), e))\n        partes = list()\n        partes.append('Se recargaron ' + str(recargados) + ' de ' + str(len(reads)) + ' nodos Read.')\n        if definidas:\n            partes.append('Variables definidas: ' + ', '.join(sorted(definidas)) + '.')\n        protegidas = info.get('protegidas', list())\n        if protegidas:\n            partes.append('Variables sin definir en el JSON (protegidas con \"\"): ' + ', '.join(protegidas) + '.')\n        if refrescadas:\n            partes.append('Fuentes reparadas: ' + ', '.join(refrescadas) + '.')\n        if sin_resolver:\n            partes.append('Sin resolver (revisa el JSON): ' + ', '.join(sin_resolver) + '.')\n        if fallos:\n            detalle = ' '.join('nodo ' + n + ': ' + str(e) for n, e in fallos)\n            partes.append('Fallos de recarga: ' + detalle)\n        nuke.message(NL.join(partes))\n        return\n\n    if action in ('scan_reads', 'scan_writes'):\n        nclass = 'Read' if action == 'scan_reads' else 'Write'\n        prev = 'REV_READ_' if nclass == 'Read' else 'REV_WRITE_'\n        data = load_db()\n        u_paths = data.get('users', dict()).get(_value('pulldown'), dict())\n        folders = data.get('folders', list())\n        mx, my = nodo.xpos(), nodo.ypos()\n\n        def _dentro_backdrop(n, bd):\n            w = bd\['bdwidth'].value() if 'bdwidth' in bd.knobs() else 0.0\n            h = bd\['bdheight'].value() if 'bdheight' in bd.knobs() else 0.0\n            return (bd.xpos() < n.xpos() < bd.xpos() + w\n                    and bd.ypos() < n.ypos() < bd.ypos() + h)\n\n        def _sin_entradas(n):\n            for i in range(n.inputs()):\n                if n.input(i) is not None:\n                    return False\n            return True\n\n        with parent_ctx:\n            # S10f/3: candidatos agrupados por id(file) como v1 (los clones\n            # linked comparten el wrapper del knob file). Se prefiere el miembro\n            # fuera de un backdrop previo (el original) y, como fallback para\n            # scripts viejos renombrados por v1, el de nombre no-REV.\n            grupos = dict()\n            for n in nuke.allNodes(nclass):\n                if n.knob('file'):\n                    grupos.setdefault(id(n.knob('file')), list()).append(n)\n            bds_prev = \[bd for bd in nuke.allNodes('BackdropNode')\n                        if bd.name().startswith(prev + 'BD_')]\n            estaticos = list()\n            for nodos in grupos.values():\n                fuera = \[x for x in nodos\n                         if not any(_dentro_backdrop(x, bd) for bd in bds_prev)]\n                pool = fuera if fuera else nodos\n                reales = \[x for x in pool if not x.name().startswith('REV_')] or sorted(pool, key=lambda x: x.xpos())\n                n = reales\[0]\n                ruta = (n.knob('file').value() or '').strip()\n                if ruta and LB not in n.knob('file').toScript():\n                    estaticos.append(n)\n            if not estaticos:\n                nuke.message('Todos los nodos ' + nclass + ' ya usan rutas relativas.')\n                return\n\n            with nuke.Undo():\n                nuke.Undo.name('Identificar sin Rutas Relativas ' + nclass)\n                # S10f/2: limpiar el scan anterior. Solo se borran los clones\n                # linked seguros (clones()>0, sin entradas, sin dependientes)\n                # que viven dentro de un backdrop previo; nunca nada mas.\n                for bd in list(nuke.allNodes('BackdropNode')):\n                    if not bd.name().startswith(prev + 'BD_'):\n                        continue\n                    for n in list(nuke.allNodes(nclass)):\n                        if not _dentro_backdrop(n, bd):\n                            continue\n                        if (n.clones() > 0 and _sin_entradas(n)\n                                and not n.dependent()):\n                            nuke.delete(n)\n                    nuke.delete(bd)\n\n                columnas = dict()\n                for f in folders:\n                    columnas.__setitem__(f.get('id'), list())\n                columnas.__setitem__('OTROS', list())\n                for n in estaticos:\n                    ruta_norm = n.knob('file').value().replace(BS, '/').lower()\n                    asignado = False\n                    for f in folders:\n                        fid = f.get('id')\n                        tail = u_paths.get(fid, '').rstrip('/').split('/')\[-1].lower()\n                        if ('/' + fid.lower() + '/' in ruta_norm) or (tail and '/' + tail + '/' in ruta_norm):\n                            columnas.get(fid).append(n)\n                            asignado = True\n                            break\n                    if not asignado:\n                        columnas.get('OTROS').append(n)\n                offset_x = 260 if nclass == 'Read' else 1100\n                colores = (0x1c2833ff, 0x14213dff, 0x1e3a2fff, 0x112233ff, 0x2d1e2fff)\n                c_idx = 0\n                for col_name, nodos_col in columnas.items():\n                    if not nodos_col:\n                        continue\n                    for x in nuke.allNodes():\n                        x.setSelected(False)\n                    for x in nodos_col:\n                        x.setSelected(True)\n                    nuke.cloneSelected()\n                    clones = nuke.selectedNodes()\n                    for i, c in enumerate(clones):\n                        # S10f/1: NUNCA renombrar el clon: cloneSelected crea un\n                        # clone LINKED que comparte el knob 'name' con el original,\n                        # y renombrarlo le cambia el nombre al original. El clon\n                        # queda linked: editar la columna edita el original.\n                        for idx in range(c.inputs()):\n                            c.setInput(idx, None)\n                        c.setXYpos(mx + offset_x, my - 100 + (i * 120))\n                    bd = nuke.nodes.BackdropNode(xpos=mx + offset_x - 40, ypos=my - 160, bdwidth=230, bdheight=(len(clones) * 120) + 110, label='<center><h3>' + nclass.upper() + ': ' + col_name + '</h3></center>', note_font_size=12, tile_color=colores\[c_idx % len(colores)])\n                    bd.knob('name').setValue(prev + 'BD_' + col_name)\n                    offset_x += 260\n                    c_idx += 1\n                for x in nuke.allNodes():\n                    x.setSelected(False)\n                for x in estaticos:\n                    x.setSelected(True)\n        nuke.message('Se identificaron ' + str(len(estaticos)) + ' nodos ' + nclass + ' sin rutas relativas.')\n        return\n\n    if action in ('convert_reads', 'convert_writes'):\n        nclass = 'Read' if action == 'convert_reads' else 'Write'\n        prev = 'REV_READ_' if nclass == 'Read' else 'REV_WRITE_'\n        data = load_db()\n        u_paths = data.get('users', dict()).get(_value('pulldown'), dict())\n        folders = data.get('folders', list())\n        cap_conf = cap_configurado()\n        cap_low = cap_conf.lower()\n        avisos = list()\n\n        # S10g: compilar regex y armar bases/tokens una vez por conversion, no por nodo.\n        re_cap = re.compile('^(ep|cap)?\[_-]?\[0-9]\{2,4\}\$')\n        re_anio = re.compile('/\[0-9]\{4\}/\[^/]+/(.*)\$')\n        re_drive = re.compile('^\[A-Za-z]:/')\n        re_proyecto = re.compile('/\[0-9]\{4\}/(\[^/]+)/')\n\n        bases = list()\n        for f in folders:\n            fid = f.get('id')\n            var = 'PYTHON_' + fid\n            bases.append((u_paths.get(fid, ''), var))\n            for otro in data.get('users', dict()).values():\n                bases.append((otro.get(fid, ''), var))\n        bases = list(b for b in bases if b\[0] and b\[0].strip())\n        bases.sort(key=lambda b: len(b\[0]), reverse=True)\n\n        tokens = list()\n        for base, var in bases:\n            tokens.append(('/' + var.replace('PYTHON_', '').lower() + '/', var))\n            seg = base.replace(BS, '/').rstrip('/').split('/')\[-1]\n            if seg:\n                tokens.append(('/' + seg.lower() + '/', var))\n        tokens.sort(key=lambda t: len(t\[0]), reverse=True)\n\n        def es_cap(seg):\n            return bool(re_cap.match(seg.lower()))\n\n        def a_relativa(var, resto):\n            resto = resto.lstrip('/')\n            seg = resto.split('/')\[0] if resto else ''\n            if seg and es_cap(seg):\n                if cap_conf:\n                    if seg.lower() == cap_low:\n                        resto = LB + 'python ' + LC + 'PYTHON_CAP_DIR' + RC + RB + resto\[len(seg) + 1:]\n                    else:\n                        avisos.append('cap_otro')\n                else:\n                    avisos.append('cap_sin_check')\n            return LB + 'python ' + LC + var + RC + RB + '/' + resto\n\n        def convertir_ruta(ruta):\n            if not ruta or not ruta.strip():\n                return ruta\n            ruta = ruta.replace(BS, '/')\n            low = ruta.lower()\n            if low.strip().startswith(LB):\n                return ruta\n            for base, var in bases:\n                base = base.replace(BS, '/').rstrip('/')\n                if base and low.startswith(base.lower() + '/'):\n                    return a_relativa(var, ruta\[len(base) + 1:])\n            for token, var in tokens:\n                idx = low.find(token)\n                if idx >= 0:\n                    return a_relativa(var, ruta\[idx + len(token):])\n            m = re_anio.search(ruta)\n            if m:\n                resto = m.group(1)\n                if resto.lower().startswith('comp/'):\n                    return a_relativa('PYTHON_COMP', resto\[5:])\n                return a_relativa('PYTHON_COMP', '../' + resto)\n            segs = ruta.split('/')\n            if low.startswith('/volumes/') and len(segs) > 3:\n                return a_relativa('PYTHON_COMP', '/'.join(segs\[3:]))\n            if re_drive.match(ruta):\n                return a_relativa('PYTHON_COMP', ruta\[3:])\n            return a_relativa('PYTHON_COMP', ruta)\n\n        with parent_ctx:\n            sel_activa = nuke.selectedNodes()\n            if sel_activa:\n                sel = list(n for n in sel_activa if n.Class() == nclass and n.knob('file') and LB not in n.knob('file').toScript())\n            else:\n                sel = list()\n            if not sel:\n                todos = list(n for n in nuke.allNodes(nclass) if n.knob('file') and LB not in n.knob('file').toScript())\n                if not todos:\n                    nuke.message('No hay nodos ' + nclass + ' con rutas estaticas validas.')\n                    return\n                if not sel_activa:\n                    if nuke.ask('Convertir los ' + str(len(todos)) + ' nodos ' + nclass + ' estaticos de la escena?'):\n                        sel = todos\n                    else:\n                        return\n                else:\n                    nuke.message('Los nodos seleccionados no son del tipo ' + nclass + ' o ya tienen rutas relativas.')\n                    return\n            cc = 0\n            proj_actual = _value('proyecto').strip()\n            otros_proj = set()\n            n_otros = 0\n            with nuke.Undo():\n                nuke.Undo.name('Convertir Rutas ' + nclass)\n                for n in sel:\n                    act = n.knob('file').value()\n                    nueva = convertir_ruta(act)\n                    if act != nueva:\n                        n.knob('file').setValue(nueva)\n                        cc += 1\n                        marca = re_proyecto.search(act)\n                        if marca and proj_actual and marca.group(1).upper() != proj_actual.upper():\n                            otros_proj.add(marca.group(1))\n                            n_otros += 1\n            if cc > 0:\n                for bd in nuke.allNodes('BackdropNode'):\n                    if bd.name().startswith(prev + 'BD_'):\n                        nuke.delete(bd)\n        notas = list()\n        if n_otros > 0:\n            notas.append('Atencion: ' + str(n_otros) + ' ruta(s) pertenecen a otro proyecto (' + ', '.join(sorted(otros_proj)) + ') y se mapearon a las carpetas de ' + proj_actual + '. Verifica el proyecto o el JSON.')\n        n_cap_otro = avisos.count('cap_otro')\n        if n_cap_otro > 0:\n            notas.append('Atencion: ' + str(n_cap_otro) + ' ruta(s) tienen un capitulo distinto de ' + cap_conf + ' y quedaron con el capitulo literal.')\n        n_cap_off = avisos.count('cap_sin_check')\n        if n_cap_off > 0:\n            notas.append('Aviso: ' + str(n_cap_off) + ' ruta(s) parecen tener capitulo. Activa Caps y escribi el capitulo para volverlo variable.')\n        nuke.message('Se convirtieron ' + str(cc) + ' nodos ' + nclass + ' a rutas relativas.' + ''.join(NL + n for n in notas))\n        return\n"}
}
 Input {
  inputs 0
  name Input1
  xpos 0
  ypos -100
 }
 Output {
  name Output1
  xpos 0
  ypos 300
 }
 Write {
  inputs 0
  file "\[python \{PYTHON_FROM_VFX\}]/\[python \{PYTHON_CAP_DIR\}]MATTE/\[file rootname \[file tail \[value root.name]]]_Rec709.mp4"
  file_type mov
  mov64_format "mp4 (MP4 (MPEG-4 Part 14))"
  mov64_codec h264
  mov_h264_codec_profile "High 4:2:0 8-bit"
  mov64_pixel_format {
   {0}
   "yuv420p\tYCbCr 4:2:0 8-bit"
  }
  mov64_quality High
  mov64_fast_start true
  mov64_write_timecode true
  mov64_gop_size 12
  mov64_b_frames 0
  mov64_bitrate 28000
  mov64_bitrate_tolerance 0
  mov64_quality_min 1
  mov64_quality_max 3
  raw true
  colorspace "Gamma 2.2 Encoded Rec.709"
  create_directories true
  checkHashOnRead false
  in_colorspace scene_linear
  out_colorspace scene_linear
  ocioColorspace scene_linear
  display "sRGB - Display"
  view "ACES 2.0 - SDR 100 nits (Rec.709)"
  name PreviewRec709
  label PreviewRec709
  xpos 150
  ypos 102
 }
