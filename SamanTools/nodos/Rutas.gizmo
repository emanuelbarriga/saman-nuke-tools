 Write {
  inputs 0
  file "\[python \{PYTHON_FROM_VFX\}]\[date %Y%m%d]/DWG/\[set n \[file rootname \[file tail \[value root.name]]]; set b \[regsub -nocase \{_v\\d+\} \$n \"\"]; set c \[regsub \{_(\[A-Za-z]\{2,3\})\$\} \$b \"\"]; if \{\[regexp -nocase \{_v(\\d+)\} \$n - vnum]\} \{scan \$vnum %d v_int; set v \[format \"_V%02d\" \$v_int]\} \{set v \"_V01\"\}; format \"%s%s\" \$c \$v]/\[set n \[file rootname \[file tail \[value root.name]]]; set b \[regsub -nocase \{_v\\d+\} \$n \"\"]; set c \[regsub \{_(\[A-Za-z]\{2,3\})\$\} \$b \"\"]; if \{\[regexp -nocase \{_v(\\d+)\} \$n - vnum]\} \{scan \$vnum %d v_int; set v \[format \"_V%02d\" \$v_int]\} \{set v \"_V01\"\}; format \"%s%s\" \$c \$v].####.exr"
  file_type exr
  first_part rgba
