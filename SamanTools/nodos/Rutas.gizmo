 addUserKnob {26 db_json_view l "Base de Datos JSON" T "\{\n  \"active_user\": \"Mac\",\n  \"folders\": \[\n    \{\n      \"id\": \"TO_VFX\",\n      \"label\": \"Material Original\",\n      \"knob\": \"folder_TO_VFX\"\n    \},\n    \{\n      \"id\": \"COMP\",\n      \"label\": \"Composiciones\",\n      \"knob\": \"folder_COMP\"\n    \},\n    \{\n      \"id\": \"ASSETS\",\n      \"label\": \"Assets\",\n      \"knob\": \"folder_ASSETS\"\n    \},\n    \{\n      \"id\": \"FROM_VFX\",\n      \"label\": \"Entregas\",\n      \"knob\": \"folder_FROM_VFX\"\n    \}\n  ],\n  \"users\": \{\n    \"Mac\": \{\n      \"TO_VFX\": \"/Volumes/wupm/2026/PALF/TO_VFX/\",\n      \"COMP\": \"/Volumes/wupm/2026/PALF/COMP/\",\n      \"ASSETS\": \"/Volumes/wupm/2026/Global Assets/\",\n      \"FROM_VFX\": \"/Volumes/wupm/2026/PALF/FROM_VFX/\"\n    \},\n    \"Linux\": \{\n      \"TO_VFX\": \"/mnt/wupm/2026/PALF/TO_VFX/\",\n      \"COMP\": \"/mnt/wupm/2026/PALF/COMP/\",\n      \"ASSETS\": \"/mnt/wupm/2026/Global Assets/\",\n      \"FROM_VFX\": \"/mnt/wupm/2026/PALF/FROM_VFX/\"\n    \},\n    \"Windows\": \{\n      \"TO_VFX\": \"L:/2026/PALF/TO_VFX/\",\n      \"COMP\": \"L:/2026/PALF/COMP/\",\n      \"ASSETS\": \"L:/2026/Global Assets/\",\n      \"FROM_VFX\": \"L:/2026/PALF/FROM_VFX/\"\n    \},\n    \"MacLocal\": \{\n      \"TO_VFX\": \"~/VFX/2026/PALF/TO_VFX/\",\n      \"COMP\": \"~/VFX/2026/PALF/COMP/\",\n      \"ASSETS\": \"~/VFX/2026/Global Assets/\",\n      \"FROM_VFX\": \"~/VFX/2026/PALF/FROM_VFX/\"\n    \}\n  \}\n\}"}
