# RUTAS — Nodo de Rutas VFX (TO_VFX / COMP / FROM_VFX)
#
# INSTRUCCIONES:
#   1. Selecciona TODO lo que está debajo de esta línea (desde el comentario marcador hasta el final).
#   2. Pégalo sobre tu script del nodo. El contenido debe ir desde "NoOp {" hasta la llave de cierre final "}".
#   3. NO incluyas las líneas "set cut_paste_input [stack 0]" ni "push $cut_paste_input" (son del portapapeles).
#   4. Guarda el archivo (Cmd+S).
#
# ====== PEGA AQUÍ EL CONTENIDO DEL NODO (desde "NoOp {" hasta "}") ======
NoOp {
 name RUTAS
 knobChanged "\nfrom SamanTools import rutas\nrutas.actualizar(nuke.thisNode())\n"
 tile_color 0x6aff55ff
 gl_color 0x55ffbfff
 label "PRINCIPALES \nACTIVAS\nGLOBALES"
 selected true
 xpos 494
 ypos 44
 addUserKnob {20 Rutas}
 addUserKnob {26 Usuario l "" +STARTLINE T "\n"}
 addUserKnob {4 UsuarioActivo l "Usuario Activo" M {MacServer Windows Artist ""}}
 addUserKnob {1 string l Proyecto}
 string HTLR
 addUserKnob {22 ActualizarProyecto l Actualizar -STARTLINE T "import nuke\nimport re\n\nn = nuke.thisNode()\nproy = n\['string'].value().strip()\n\nif not proy:\n    nuke.message('Por favor, ingrese un código o nombre de proyecto válido.')\nelse:\n    knobs_objetivo = \[\n        'TO_VFX_SERVER_MAC', 'comp_SERVER_MAC', 'FROM_VFX_SERVER_MAC',\n        'TO_VFX_SERVER_WINDOWS', 'comp_SERVER_WINDOWS', 'FROM_VFX_SERVER_WINDOWS',\n        'TO_VFX_SERVER_ARTIST', 'comp_SERVER_ARTIST', 'FROM_VFX_SERVER_ARTIST'\n    ]\n    \n    cambios = 0\n    for k_name in knobs_objetivo:\n        if k_name in n.knobs():\n            val = n\[k_name].value()\n            if val:\n                nueva_ruta = re.sub(r'/\[^/]+/(TO_VFX|COMP|FROM_VFX)(/|\$)', '/' + proy + r'/\\1\\2', val, flags=re.IGNORECASE)\n                if val != nueva_ruta:\n                    n\[k_name].setValue(nueva_ruta)\n                    cambios += 1\n    \n    n\['UsuarioActivo'].setValue(n\['UsuarioActivo'].value())\n    nuke.message('Se actualizaron ' + str(cambios) + ' rutas al proyecto: \"' + proy + '\".')\n    try:\n        from SamanTools import proyecto\n        proyecto.actualizar_desde_nodo_rutas(n)\n    except Exception:\n        pass"}
 addUserKnob {26 text l " " T " "}
 addUserKnob {26 ""}
 addUserKnob {26 RutaMacServer l "Ruta MacServer" T " "}
 addUserKnob {2 TO_VFX_SERVER_MAC}
 TO_VFX_SERVER_MAC /Volumes/wupm/2026/HTLR/TO_VFX/
 addUserKnob {2 comp_SERVER_MAC}
 comp_SERVER_MAC /Volumes/wupm/2026/HTLR/COMP/
 addUserKnob {2 FROM_VFX_SERVER_MAC}
 FROM_VFX_SERVER_MAC /Volumes/wupm/2026/HTLR/FROM_VFX/
 addUserKnob {26 ""}
 addUserKnob {26 RutaWindows l "Ruta Windows" T " "}
 addUserKnob {2 TO_VFX_SERVER_WINDOWS}
 TO_VFX_SERVER_WINDOWS L:/2026/HTLR/TO_VFX/
 addUserKnob {2 comp_SERVER_WINDOWS}
 comp_SERVER_WINDOWS L:/2026/HTLR/COMP/
 addUserKnob {2 FROM_VFX_SERVER_WINDOWS}
 FROM_VFX_SERVER_WINDOWS L:/2026/HTLR/FROM_VFX/
 addUserKnob {26 ""}
 addUserKnob {26 RutaArtist l "Ruta Artist" T " "}
 addUserKnob {2 TO_VFX_SERVER_ARTIST}
 TO_VFX_SERVER_ARTIST /mnt/wupm/HTLR/TO_VFX/
 addUserKnob {2 comp_SERVER_ARTIST}
 comp_SERVER_ARTIST /mnt/media/2026/HTLR/COMP/
 addUserKnob {2 FROM_VFX_SERVER_ARTIST}
 FROM_VFX_SERVER_ARTIST /mnt/RedDeArtistas/HTLR/FROM_VFX/
 addUserKnob {26 ""}
 addUserKnob {26 RutaActual l "Ruta Actual" T "TO_VFX: /Volumes/wupm/2026/HTLR/TO_VFX/ \\\[PYTHON_TO_VFX\\]\nCOMP: /Volumes/wupm/2026/HTLR/COMP/ \\\[PYTHON_COMP\\]\nFROM_VFX: /Volumes/wupm/2026/HTLR/FROM_VFX/ \\\[PYTHON_FROM_VFX\\]"}
 addUserKnob {26 text_3 l " " T " "}
 addUserKnob {26 text_scan l "" +STARTLINE T "<b>Escanear y revisar rutas estáticas fijas:</b>"}
 addUserKnob {26 Espacio_2_1 l "  " -STARTLINE T "   "}
 addUserKnob {22 scan_1 l TO_VFX -STARTLINE T "import nuke\nimport re\n\nmaster = nuke.thisNode()\nmx, my = master.xpos(), master.ypos()\n\n# 1. Agrupar TODOS los Reads del script por la identidad real de su perilla 'file'\ngrupos_clones = \{\}\nfor n in nuke.allNodes('Read'):\n    if 'file' in n.knobs():\n        # Obtenemos el ID único de memoria de la perilla\n        knob_id = id(n\['file'])\n        if knob_id not in grupos_clones:\n            grupos_clones\[knob_id] = \[]\n        grupos_clones\[knob_id].append(n)\n\n# 2. Filtrar cuáles de estos grupos son verdaderos originales estáticos de TO_VFX\norig = \[]\nfor knob_id, nodos in grupos_clones.items():\n    # Si solo hay un nodo en el grupo, es un Read 100% independiente (como tu REV_TO_VFX_1)\n    if len(nodos) == 1:\n        n = nodos\[0]\n        if n\['file'].value() and '\[' not in n\['file'].toScript():\n            if re.search(r'/TO_VFX/', n\['file'].value(), re.IGNORECASE):\n                orig.append(n)\n    else:\n        # Si hay más de un nodo, son CLONES reales entre sí. \n        # Buscamos cuál es el verdadero original (el que NO empiece con REV_ o el más a la izquierda)\n        originales_reales = \[x for x in nodos if not x.name().startswith('REV_')]\n        if not originales_reales:\n            # Si todos se llaman REV_, elegimos el que esté más a la izquierda en el Node Graph\n            originales_reales = sorted(nodos, key=lambda x: x.xpos())\n            \n        n = originales_reales\[0]\n        if n\['file'].value() and '\[' not in n\['file'].toScript():\n            if re.search(r'/TO_VFX/', n\['file'].value(), re.IGNORECASE):\n                orig.append(n)\n\n# 3. Ejecutar la clonación y organización segura\nif not orig:\n    nuke.message('No se detectaron nodos TO_VFX con ruta estática.')\nelse:\n    # Deseleccionar todo para no arrastrar nodos extra\n    for n in nuke.allNodes(): n.setSelected(False)\n    \n    # Seleccionar solo los objetivos legítimos y clonar\n    for n in orig: n.setSelected(True)\n    nuke.cloneSelected()\n    clones = nuke.selectedNodes()\n    \n    # Organizar los nuevos clones a la derecha\n    for i, c in enumerate(clones):\n        c\['name'].setValue(f'REV_TO_VFX_\{i+1\}')\n        for idx in range(c.inputs()): c.setInput(idx, None)\n        c.setXYpos(mx + 250, my - 100 + (i * 120))\n        \n    # Crear un contenedor Backdrop nuevo cada vez\n    nuke.nodes.BackdropNode(\n        xpos=mx+210, \n        ypos=my-160, \n        bdwidth=220, \n        bdheight=(len(clones)*120)+110, \n        label='<center><h2>REVISAR: TO_VFX</h2></center><br>Clones de referencia.<br>Originales seleccionados.', \n        note_font_size=12, \n        tile_color=0x1c2833ff\n    )\n    \n    # Dejar seleccionados los originales para comodidad del usuario\n    for n in nuke.allNodes(): n.setSelected(False)\n    for n in orig: n.setSelected(True)\n    \n    # Mensaje seguro sin f-string de múltiples líneas\n    num_nodos = str(len(orig))\n    salto = chr(10) + chr(10)\n    texto_final = \"Se encontraron \" + num_nodos + \" nodos TO_VFX estáticos.\" + salto + \"Se creó una nueva galería de clones a la derecha sin borrar nada anterior.\"\n    \n    nuke.message(texto_final)"}
 addUserKnob {26 Espacio_1 l "  " -STARTLINE T "   "}
 addUserKnob {22 scan_2 l FROM_VFX -STARTLINE T "import nuke\nimport re\n\nmaster = nuke.thisNode()\nmx, my = master.xpos(), master.ypos()\n\n# 1. Agrupar TODOS los Reads del script que sean clones reales entre sí\ngrupos_clones = \[]\nfor n in nuke.allNodes('Read'):\n    if 'file' in n.knobs():\n        encontrado = False\n        for grupo in grupos_clones:\n            # El operador == en perillas de Nuke compara el núcleo C++ subyacente.\n            # Si los nodos son clones reales, esto devuelve True independientemente de los wrappers de Python.\n            if n\['file'] == grupo\[0]\['file']:\n                grupo.append(n)\n                encontrado = True\n                break\n        if not encontrado:\n            grupos_clones.append(\[n])\n\n# 2. Filtrar cuáles de estos grupos contienen originales estáticos de FROM_VFX\norig = \[]\nfor nodos in grupos_clones:\n    # Si solo hay un nodo en el grupo, es un Read totalmente independiente\n    if len(nodos) == 1:\n        n = nodos\[0]\n        if n\['file'].value() and '\[' not in n\['file'].toScript():\n            if re.search(r'/FROM_VFX/', n\['file'].value(), re.IGNORECASE):\n                orig.append(n)\n    else:\n        # Si hay más de un nodo, son clones reales.\n        # Buscamos al verdadero original (el que NO empiece con el prefijo REV_)\n        originales_reales = \[x for x in nodos if not x.name().startswith('REV_')]\n        if not originales_reales:\n            # Si todos se llaman REV_ por algún error previo, elegimos el de más a la izquierda\n            originales_reales = sorted(nodos, key=lambda x: x.xpos())\n            \n        n = originales_reales\[0]\n        if n\['file'].value() and '\[' not in n\['file'].toScript():\n            if re.search(r'/FROM_VFX/', n\['file'].value(), re.IGNORECASE):\n                orig.append(n)\n\n# 3. Ejecutar la clonación y organización segura\nif not orig:\n    nuke.message('No se detectaron nodos FROM_VFX con ruta estática.')\nelse:\n    # Deseleccionar todo para evitar arrastrar selecciones accidentales\n    for n in nuke.allNodes(): n.setSelected(False)\n    \n    # Seleccionar solo los objetivos legítimos y clonar\n    for n in orig: n.setSelected(True)\n    nuke.cloneSelected()\n    clones = nuke.selectedNodes()\n    \n    # Organizar los nuevos clones a la derecha\n    for i, c in enumerate(clones):\n        c\['name'].setValue(f'REV_FROM_VFX_\{i+1\}')\n        for idx in range(c.inputs()): c.setInput(idx, None)\n        c.setXYpos(mx + 250, my - 100 + (i * 120))\n        \n    # Crear un contenedor Backdrop nuevo con su color correspondiente (0x112233ff)\n    nuke.nodes.BackdropNode(\n        xpos=mx+210, \n        ypos=my-160, \n        bdwidth=220, \n        bdheight=(len(clones)*120)+110, \n        label='<center><h2>REVISAR: FROM_VFX</h2></center><br>Clones de referencia.<br>Originales seleccionados.', \n        note_font_size=12, \n        tile_color=0x112233ff\n    )\n    \n    # Dejar seleccionados los originales para comodidad del usuario\n    for n in nuke.allNodes(): n.setSelected(False)\n    for n in orig: n.setSelected(True)\n    \n    # Mensaje seguro sin f-strings multilínea conflictivos\n    num_nodos = str(len(orig))\n    salto = chr(10) + chr(10)\n    texto_final = \"Se encontraron \" + num_nodos + \" nodos FROM_VFX estáticos.\" + salto + \"Se creó una nueva galería de clones a la derecha sin borrar nada anterior.\"\n    \n    nuke.message(texto_final)"}
 addUserKnob {26 Espacio_2 l "  " -STARTLINE T "   "}
 addUserKnob {22 scan_3 l COMP -STARTLINE T "import nuke\nimport re\n\nmaster = nuke.thisNode()\nmx, my = master.xpos(), master.ypos()\n\n# 1. Agrupar TODOS los Reads del script que sean clones reales entre sí\ngrupos_clones = \[]\nfor n in nuke.allNodes('Read'):\n    if 'file' in n.knobs():\n        encontrado = False\n        for grupo in grupos_clones:\n            # Comparamos el núcleo subyacente de la perilla para detectar clones reales\n            if n\['file'] == grupo\[0]\['file']:\n                grupo.append(n)\n                encontrado = True\n                break\n        if not encontrado:\n            grupos_clones.append(\[n])\n\n# 2. Filtrar cuáles de estos grupos son originales estáticos de COMP / OTROS\norig = \[]\nfor nodos in grupos_clones:\n    # Si solo hay un nodo, es un Read independiente\n    if len(nodos) == 1:\n        n = nodos\[0]\n        if n\['file'].value() and '\[' not in n\['file'].toScript():\n            # Condición COMP: NO debe tener /TO_VFX/ ni /FROM_VFX/\n            if not re.search(r'/TO_VFX/', n\['file'].value(), re.IGNORECASE) and not re.search(r'/FROM_VFX/', n\['file'].value(), re.IGNORECASE):\n                orig.append(n)\n    else:\n        # Si hay más de un nodo, buscamos al verdadero original (el que NO empiece con REV_)\n        originales_reales = \[x for x in nodos if not x.name().startswith('REV_')]\n        if not originales_reales:\n            originales_reales = sorted(nodos, key=lambda x: x.xpos())\n            \n        n = originales_reales\[0]\n        if n\['file'].value() and '\[' not in n\['file'].toScript():\n            if not re.search(r'/TO_VFX/', n\['file'].value(), re.IGNORECASE) and not re.search(r'/FROM_VFX/', n\['file'].value(), re.IGNORECASE):\n                orig.append(n)\n\n# 3. Ejecutar la clonación y organización segura\nif not orig:\n    nuke.message('No se detectaron nodos COMP/OTROS con ruta estática.')\nelse:\n    # Deseleccionar todo para evitar arrastrar selecciones accidentales\n    for n in nuke.allNodes(): n.setSelected(False)\n    \n    # Seleccionar solo los originales de COMP y clonar\n    for n in orig: n.setSelected(True)\n    nuke.cloneSelected()\n    clones = nuke.selectedNodes()\n    \n    # Organizar los nuevos clones a la derecha\n    for i, c in enumerate(clones):\n        c\['name'].setValue(f'REV_COMP_\{i+1\}')\n        for idx in range(c.inputs()): c.setInput(idx, None)\n        c.setXYpos(mx + 250, my - 100 + (i * 120))\n        \n    # Crear contenedor Backdrop con su color correspondiente (0x14213dff)\n    nuke.nodes.BackdropNode(\n        xpos=mx+210, \n        ypos=my-160, \n        bdwidth=220, \n        bdheight=(len(clones)*120)+110, \n        label='<center><h2>REVISAR: COMP</h2></center><br>Clones de referencia.<br>Originales seleccionados.', \n        note_font_size=12, \n        tile_color=0x14213dff\n    )\n    \n    # Dejar seleccionados los originales para comodidad del usuario\n    for n in nuke.allNodes(): n.setSelected(False)\n    for n in orig: n.setSelected(True)\n    \n    # Mensaje seguro sin f-strings multilínea conflictivos\n    num_nodos = str(len(orig))\n    salto = chr(10) + chr(10)\n    texto_final = \"Se encontraron \" + num_nodos + \" nodos COMP/OTROS estáticos.\" + salto + \"Se creó una nueva galería de clones a la derecha sin borrar nada anterior.\"\n    \n    nuke.message(texto_final)"}
 addUserKnob {26 Espacio_3 l "  " -STARTLINE T "   "}
 addUserKnob {22 scan_4 l TODOS -STARTLINE T "import nuke\nimport re\n\nmaster = nuke.thisNode()\nmx, my = master.xpos(), master.ypos()\n\n# 1. Agrupar TODOS los Reads del script que sean clones reales entre sí\ngrupos_clones = \[]\nfor n in nuke.allNodes('Read'):\n    if 'file' in n.knobs():\n        encontrado = False\n        for grupo in grupos_clones:\n            if n\['file'] == grupo\[0]\['file']:\n                grupo.append(n)\n                encontrado = True\n                break\n        if not encontrado:\n            grupos_clones.append(\[n])\n\n# 2. Filtrar cuáles de estos grupos contienen originales estáticos legítimos\ntodos_estaticos = \[]\nfor nodos in grupos_clones:\n    if len(nodos) == 1:\n        n = nodos\[0]\n        if n\['file'].value() and '\[' not in n\['file'].toScript():\n            todos_estaticos.append(n)\n    else:\n        originales_reales = \[x for x in nodos if not x.name().startswith('REV_')]\n        if not originales_reales:\n            originales_reales = sorted(nodos, key=lambda x: x.xpos())\n            \n        n = originales_reales\[0]\n        if n\['file'].value() and '\[' not in n\['file'].toScript():\n            todos_estaticos.append(n)\n\n# 3. Clasificar y desplegar en columnas si se encontraron nodos\nif not todos_estaticos:\n    nuke.message('¡Excelente! Todos los nodos del proyecto ya cuentan con rutas dinamicas.')\nelse:\n    # Clasificación por subgrupos\n    to_vfx_nodes = \[n for n in todos_estaticos if re.search(r'/TO_VFX/', n\['file'].value(), re.IGNORECASE)]\n    from_vfx_nodes = \[n for n in todos_estaticos if re.search(r'/FROM_VFX/', n\['file'].value(), re.IGNORECASE)]\n    comp_nodes = \[n for n in todos_estaticos if n not in to_vfx_nodes and n not in from_vfx_nodes]\n\n    creados_to = len(to_vfx_nodes)\n    creados_from = len(from_vfx_nodes)\n    creados_comp = len(comp_nodes)\n\n    # --- COLUMNA 1: TO_VFX (Posición X: +250) ---\n    if to_vfx_nodes:\n        # ARREGLO: Buscar el número más alto existente para TO_VFX\n        nums_to = \[]\n        for x in nuke.allNodes('Read'):\n            if x.name().startswith('REV_TO_VFX_'):\n                part = x.name().replace('REV_TO_VFX_', '')\n                if part.isdigit(): nums_to.append(int(part))\n        start_to = max(nums_to) + 1 if nums_to else 1\n\n        for n in nuke.allNodes(): n.setSelected(False)\n        for n in to_vfx_nodes: n.setSelected(True)\n        nuke.cloneSelected()\n        clones = nuke.selectedNodes()\n        for i, c in enumerate(clones):\n            c\['name'].setValue(f'REV_TO_VFX_\{start_to + i\}')\n            for idx in range(c.inputs()): c.setInput(idx, None)\n            c.setXYpos(mx + 250, my - 100 + (i * 120))\n        nuke.nodes.BackdropNode(xpos=mx+210, ypos=my-160, bdwidth=220, bdheight=(len(clones)*120)+110, label='<center><h2>REVISAR: TO_VFX</h2></center>', note_font_size=12, tile_color=0x1c2833ff)\n\n    # --- COLUMNA 2: FROM_VFX (Posición X: +550) ---\n    if from_vfx_nodes:\n        # ARREGLO: Buscar el número más alto existente para FROM_VFX\n        nums_from = \[]\n        for x in nuke.allNodes('Read'):\n            if x.name().startswith('REV_FROM_VFX_'):\n                part = x.name().replace('REV_FROM_VFX_', '')\n                if part.isdigit(): nums_from.append(int(part))\n        start_from = max(nums_from) + 1 if nums_from else 1\n\n        for n in nuke.allNodes(): n.setSelected(False)\n        for n in from_vfx_nodes: n.setSelected(True)\n        nuke.cloneSelected()\n        clones = nuke.selectedNodes()\n        for i, c in enumerate(clones):\n            c\['name'].setValue(f'REV_FROM_VFX_\{start_from + i\}')\n            for idx in range(c.inputs()): c.setInput(idx, None)\n            c.setXYpos(mx + 550, my - 100 + (i * 120))\n        nuke.nodes.BackdropNode(xpos=mx+510, ypos=my-160, bdwidth=220, bdheight=(len(clones)*120)+110, label='<center><h2>REVISAR: FROM_VFX</h2></center>', note_font_size=12, tile_color=0x112233ff)\n\n    # --- COLUMNA 3: COMP / OTROS (Posición X: +850) ---\n    if comp_nodes:\n        # ARREGLO: Buscar el número más alto existente para COMP\n        nums_comp = \[]\n        for x in nuke.allNodes('Read'):\n            if x.name().startswith('REV_COMP_'):\n                part = x.name().replace('REV_COMP_', '')\n                if part.isdigit(): nums_comp.append(int(part))\n        start_comp = max(nums_comp) + 1 if nums_comp else 1\n\n        for n in nuke.allNodes(): n.setSelected(False)\n        for n in comp_nodes: n.setSelected(True)\n        nuke.cloneSelected()\n        clones = nuke.selectedNodes()\n        for i, c in enumerate(clones):\n            c\['name'].setValue(f'REV_COMP_\{start_comp + i\}')\n            for idx in range(c.inputs()): c.setInput(idx, None)\n            c.setXYpos(mx + 850, my - 100 + (i * 120))\n        nuke.nodes.BackdropNode(xpos=mx+810, ypos=my-160, bdwidth=220, bdheight=(len(clones)*120)+110, label='<center><h2>REVISAR: COMP</h2></center>', note_font_size=12, tile_color=0x14213dff)\n\n    # 4. Dejar seleccionados los originales\n    for n in nuke.allNodes(): n.setSelected(False)\n    for n in todos_estaticos: n.setSelected(True)\n\n    # Mensaje de éxito seguro\n    salto = chr(10)\n    texto_final = \"Analisis Completo Realizado:\" + salto + \\\n                  \"- TO_VFX detectados: \" + str(creados_to) + salto + \\\n                  \"- FROM_VFX detectados: \" + str(creados_from) + salto + \\\n                  \"- COMP/OTROS detectados: \" + str(creados_comp) + salto + salto + \\\n                  \"Se han organizado en 3 columnas paralelas a la derecha sin mezclar nada.\"\n    nuke.message(texto_final)"}
 addUserKnob {26 text_4 l " " T " "}
 addUserKnob {22 python_button l "Convertir NODOS SELECCIONADOS a rutas dinámicas" T "import nuke\nimport re\n\ndef convertir(ruta):\n    if not ruta or ruta.strip() == '': \n        return ruta\n        \n    # Normaliza separadores de barras\n    ruta = ruta.replace('\\\\\\\\', '/').replace('\\\\', '/')\n    \n    # Si la ruta ya es dinámica de alguna forma, la dejamos intacta\n    if ruta.strip().lower().startswith('\[python'): \n        return ruta\n        \n    ruta_lower = ruta.lower()\n    \n    # 1. Procesar casos de TO_VFX\n    if '/to_vfx/' in ruta_lower:\n        idx = ruta_lower.find('/to_vfx/') + 8\n        resto = ruta\[idx:].lstrip('/')\n        return '\[python \{PYTHON_TO_VFX\}]/' + resto\n        \n    # 2. Procesar casos de FROM_VFX\n    if '/from_vfx/' in ruta_lower:\n        idx = ruta_lower.find('/from_vfx/') + 10\n        resto = ruta\[idx:].lstrip('/')\n        return '\[python \{PYTHON_FROM_VFX\}]/' + resto\n        \n    # 3. Tratamiento inteligente para COMP / 3D / OTROS\n    # Busca la estructura estándar de un proyecto de VFX: /Año/CódigoProyecto/ (ej: /2026/PCF/)\n    match_proyecto = re.search(r'(.*?/\\d\{4\}/\[^/]+/)(.*)', ruta)\n    if match_proyecto:\n        resto_ruta = match_proyecto.group(2) # ej: 3D/FROM_3D/... o COMP/...\n        \n        # Si el material ya vive dentro de la carpeta COMP\n        if resto_ruta.lower().startswith('comp/'):\n            return '\[python \{PYTHON_COMP\}]/' + resto_ruta\[5:]\n        else:\n            # Si va a otra carpeta del proyecto (como 3D), salimos de COMP usando el salto relativo '../'\n            return '\[python \{PYTHON_COMP\}]/../' + resto_ruta\n            \n    # Fallbacks clásicos por si la ruta no cumple con la estructura /Año/Proyecto/\n    if ruta.startswith('/Volumes/'):\n        partes = ruta.split('/', 3)\n        if len(partes) >= 4: \n            return '\[python \{PYTHON_COMP\}]/' + padding_fix(partes\[3])\n    elif re.match(r'^\[A-Za-z]:/', ruta):\n        return '\[python \{PYTHON_COMP\}]/' + ruta\[3:]\n        \n    return '\[python \{PYTHON_COMP\}]/' + ruta.lstrip('/')\n\n\n# FILTRADO: Procesamos cualquier Read seleccionado que NO tenga expresiones dinámicas previas\nnodos_sel = \[\n    n for n in nuke.selectedNodes() \n    if n.Class() == 'Read' \n    and '\[' not in n\['file'].toScript()\n]\n\nif not nodos_sel:\n    nuke.message('Atencion! Seleccione al menos un nodo Read con ruta estatica.')\nelse:\n    contador = 0\n    \n    # CORRECCIÓN: Usamos el Context Manager nativo 'with nuke.Undo(...):'\n    # Esto abre y cierra el bloque de Undo de forma 100% segura en Nuke\n    with nuke.Undo(\"Convertir Rutas a Dinamicas\"):\n        for n in nodos_sel:\n            ruta_act = n\['file'].value()\n            nueva = convertir(ruta_act)\n            if ruta_act != nueva:\n                n\['file'].setValue(nueva)\n                contador += 1\n            \n    if contador > 0:\n        # Limpieza segura: Solo borramos los Backdrops de revisión de la escena\n        nombres_bd = \['REV_TO_VFX_BD', 'REV_FROM_VFX_BD', 'REV_COMP_BD', 'REV_TODOS_BD']\n        for nombre in nombres_bd:\n            bd = nuke.toNode(nombre)\n            if bd: \n                nuke.delete(bd)\n            \n        # Mensaje de éxito seguro\n        num_convertidos = str(contador)\n        salto = chr(10) + chr(10)\n        texto_final = \"Se han convertido \" + num_convertidos + \" nodos con exito.\" + salto + \"Las rutas ahora son dinamicas. Podes deshacer con Ctrl+Z una sola vez.\"\n        \n        nuke.message(texto_final)" +STARTLINE}
 addUserKnob {26 ""}
 addUserKnob {26 Variables -STARTLINE T " "}
 addUserKnob {22 copy_to_vfx l "Copiar TO_VFX" -STARTLINE T "import nuke\n\nt = '\[python \{PYTHON_TO_VFX\}]'\n\ntry:\n    import nukescripts.utils\n    nukescripts.utils.to_clipboard(t)\n    nuke.message('TO_VFX copiado al portapapeles: ' + t)\nexcept Exception:\n    try:\n        from PySide6.QtWidgets import QApplication\n        # CORRECCIÓN: Usamos list() para evitar el conflicto de corchetes con Nuke\n        app = QApplication.instance() or QApplication(list())\n        app.clipboard().setText(t)\n        nuke.message('TO_VFX copiado (PySide6): ' + t)\n    except Exception as e: \n        nuke.message('Error al copiar: ' + str(e))"}
 addUserKnob {26 text_1 l " " -STARTLINE T " "}
 addUserKnob {22 copy_comp l "Copiar COMP" -STARTLINE T "import nuke\n\nt = '\[python \{PYTHON_COMP\}]'\n\ntry:\n    import nukescripts.utils\n    nukescripts.utils.to_clipboard(t)\n    nuke.message('COMP copiado al portapapeles: ' + t)\nexcept Exception:\n    try:\n        from PySide6.QtWidgets import QApplication\n        # CORRECCIÓN: Usamos list() para evitar el conflicto de corchetes con Nuke\n        app = QApplication.instance() or QApplication(list())\n        app.clipboard().setText(t)\n        nuke.message('COMP copiado (PySide6): ' + t)\n    except Exception as e: \n        nuke.message('Error al copiar: ' + str(e))"}
 addUserKnob {26 text_2 l " " -STARTLINE T " "}
 addUserKnob {22 copy_from_vfx l "Copiar FROM_VFX" -STARTLINE T "import nuke\n\nt = '\[python \{PYTHON_FROM_VFX\}]'\n\ntry:\n    import nukescripts.utils\n    nukescripts.utils.to_clipboard(t)\n    nuke.message('FROM_VFX copiado al portapapeles: ' + t)\nexcept Exception:\n    try:\n        from PySide6.QtWidgets import QApplication\n        # CORRECCIÓN: Usamos list() para evitar el conflicto de corchetes con Nuke\n        app = QApplication.instance() or QApplication(list())\n        app.clipboard().setText(t)\n        nuke.message('FROM_VFX copiado (PySide6): ' + t)\n    except Exception as e: \n        nuke.message('Error al copiar: ' + str(e))"}
}
