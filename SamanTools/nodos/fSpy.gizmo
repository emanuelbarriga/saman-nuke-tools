set cut_paste_input [stack 0]
version 17.1 v3
push $cut_paste_input
NoOp {
 name fSpy
 onCreate "exec(nuke.thisNode().knob('Cerebro_Python').value(), \{'_FSPY_ACCION': 'init'\})"
 tile_color 0x38bdf8ff
 selected true
 xpos -429
 ypos -218
 addUserKnob {20 User}
 addUserKnob {26 hdr l "" +STARTLINE T "<b>fSpy</b> — cámara calibrada desde una foto"}
 addUserKnob {2 fspy_file l "Proyecto .fspy"}
 addUserKnob {22 btn_leer l "Leer .fspy" -STARTLINE T "exec(nuke.thisNode().knob('Cerebro_Python').value(), \{'_FSPY_ACCION': 'leer'\})"}
 addUserKnob {22 btn_editar l "Abrir en fSpy…" -STARTLINE T "exec(nuke.thisNode().knob('Cerebro_Python').value(), \{'_FSPY_ACCION': 'editar'\})"}
 addUserKnob {26 div_calibracion l calibración}
 addUserKnob {26 r_modo l "Modo de calibración" +DISABLED T —}
 addUserKnob {26 r_imagen l "Imagen y aspecto" +DISABLED T —}
 addUserKnob {26 r_sensor l "Sensor (mm)" +DISABLED T —}
 addUserKnob {26 r_focal l "Distancia focal" +DISABLED T —}
 addUserKnob {26 r_fov l "Campo de visión H / V" +DISABLED T —}
 addUserKnob {26 r_principal l "Punto principal" +DISABLED T —}
 addUserKnob {26 r_fuga l "Puntos de fuga" +DISABLED T —}
 addUserKnob {26 r_escala l Escala +DISABLED T —}
 addUserKnob {26 r_referencia l "Distancia de referencia" +DISABLED T —}
 addUserKnob {26 estado l "" +STARTLINE T "<i>Elegí un .fspy y apretá Leer.</i>"}
 addUserKnob {26 div_generados l "nodos generados"}
 addUserKnob {6 crear_camara l Cámara -STARTLINE}
 crear_camara true
 addUserKnob {6 crear_cubo l "Cubo de referencia en el origen" -STARTLINE}
 crear_cubo true
 addUserKnob {7 tamano_cubo l "Tamaño del cubo" t "Lado del cubo, en unidades del mundo de fSpy."}
 tamano_cubo 1
 addUserKnob {6 crear_read l "Read con la imagen del proyecto" t "El .fspy lleva la foto adentro: se extrae a ~/.nuke/fspy_cache y se lee desde ahí, así el Read no depende de que la imagen original siga en su lugar." -STARTLINE}
 crear_read true
 addUserKnob {22 btn_construir l Construir -STARTLINE T "exec(nuke.thisNode().knob('Cerebro_Python').value(), \{'_FSPY_ACCION': 'construir'\})"}
 addUserKnob {22 btn_borrar l "Borrar nodos generados" -STARTLINE T "exec(nuke.thisNode().knob('Cerebro_Python').value(), \{'_FSPY_ACCION': 'borrar'\})"}
 addUserKnob {26 info l "" +STARTLINE}
 addUserKnob {3 fspy_init +INVISIBLE}
 fspy_init 1
 addUserKnob {52 Cerebro_Python l "" -STARTLINE +INVISIBLE T "\"\"\"Motor de fSpy v2 autocontenido. Vive embebido en el knob Cerebro_Python de fSpy_v2.gizmo.\n\nNo importa nada de SamanTools: el nodo es independiente. Los botones del panel\nejecutan el motor en un namespace PRIVADO (no ensucia __main__):\n\n    exec(nuke.thisNode().knob('Cerebro_Python').value(), \{'_FSPY_ACCION': 'leer'\})\n\nLee un proyecto .fspy (spec oficial stuffmatic/fSpy) y construye junto al panel:\n    <nombre>_cam   Camera con la solucion: focal, aperturas y matriz 4x4\n    <nombre>_cube  Cube de referencia apoyado en el origen del mundo\n    <nombre>_read  Read con la foto embebida en el .fspy\n\nCambios v2 (estabilidad):\n* Construir ACTUALIZA los nodos generados si ya existen: conservan posicion y\n  conexiones (antes se borraban y recreaban, y la camara quedaba desconectada\n  del ScanlineRender del artista).\n* Los nodos se crean con nuke.nodes.*: no se conectan solos al nodo\n  seleccionado (antes el Cube quedaba enchufado al panel fSpy).\n* Construir y Borrar son un solo paso de undo.\n* onCreate solo fuerza los defaults la primera vez (knob oculto fspy_init):\n  al reabrir el script se respetan los valores del artista.\n\"\"\"\n\nimport hashlib\nimport json\nimport math\nimport os\nimport struct\nimport subprocess\nimport sys\nimport tempfile\n\nimport nuke\n\nFILE_ID = b\"fspy\"\nSUPPORTED_VERSION = 1\n\nMAGIAS_IMAGEN = (\n    (b\"\\xff\\xd8\\xff\", \".jpg\"),\n    (b\"\\x89PNG\\r\\n\\x1a\\n\", \".png\"),\n    (b\"GIF8\", \".gif\"),\n    (b\"II*\\x00\", \".tif\"),\n    (b\"MM\\x00*\", \".tif\"),\n    (b\"RIFF\", \".webp\"),\n)\n\n\n# ------------------------------------------------------------------ núcleo\ndef core_read(path):\n    \"\"\"Lee el .fspy. Lanza ValueError si el archivo no es un .fspy v1 válido.\"\"\"\n    with open(path, \"rb\") as fh:\n        head = fh.read(16)\n        if len(head) < 16:\n            raise ValueError(\"%s: demasiado corto para ser un .fspy\" % path)\n        file_id, version, state_size, image_size = struct.unpack(\"<4sIII\", head)\n        if file_id != FILE_ID:\n            raise ValueError(\"%s: no empieza con 'fspy' (%r)\" % (path, file_id))\n        if version != SUPPORTED_VERSION:\n            raise ValueError(\n                \"%s: versión %d no soportada (solo %d)\" % (path, version, SUPPORTED_VERSION)\n            )\n        raw = fh.read(state_size)\n        if len(raw) != state_size:\n            raise ValueError(\n                \"%s: estado truncado (%d de %d bytes)\" % (path, len(raw), state_size)\n            )\n    state = json.loads(raw)\n    cam = state.get(\"cameraParameters\")\n    if not cam:\n        raise ValueError(\n            \"%s: el proyecto no tiene solución de cámara \"\n            \"(los puntos de fuga son inválidos o el proyecto está a medio calibrar)\" % path\n        )\n\n    cal = state\[\"calibrationSettingsBase\"]\n    camdata = cal\[\"cameraData\"]\n    sensor_w, sensor_h = _core_sensor_size(camdata)\n\n    f_rel = float(cam\[\"relativeFocalLength\"])\n    width, height = int(cam\[\"imageWidth\"]), int(cam\[\"imageHeight\"])\n    pp = cam\[\"principalPoint\"]\n\n    view_t = _core_rows(cam\[\"viewTransform\"])\n    cam_t = _core_rows(cam\[\"cameraTransform\"])\n\n    return \{\n        \"path\": path,\n        \"version\": version,\n        \"state_size\": state_size,\n        \"image_size\": image_size,\n        \"mode\": state\[\"globalSettings\"]\[\"calibrationMode\"],\n        \"width\": width,\n        \"height\": height,\n        \"aspect\": width / float(height),\n        \"f_rel\": f_rel,\n        \"focal_mm\": f_rel * sensor_w / 2.0,\n        \"fov_h_deg\": math.degrees(2.0 * math.atan(1.0 / f_rel)),\n        \"fov_v_deg\": math.degrees(2.0 * math.atan(1.0 / (f_rel * width / float(height)))),\n        \"sensor_w_mm\": sensor_w,\n        \"sensor_h_mm\": sensor_h,\n        \"principal_point\": (float(pp\[\"x\"]), float(pp\[\"y\"])),\n        \"view_transform\": view_t,\n        \"camera_transform\": cam_t,\n        \"camera_position\": (cam_t\[0]\[3], cam_t\[1]\[3], cam_t\[2]\[3]),\n        \"reference_distance\": float(cal.get(\"referenceDistance\") or 0.0),\n        \"reference_unit\": cal.get(\"referenceDistanceUnit\") or \"\",\n        # el origen del mundo expresado en espacio de cámara: T_view * (0,0,0,1)\n        \"world_origin_in_camera\": (view_t\[0]\[3], view_t\[1]\[3], view_t\[2]\[3]),\n        \"scale\": _core_length((view_t\[0]\[3], view_t\[1]\[3], view_t\[2]\[3])) / max(f_rel, 1e-9),\n        \"vanishing_points\": \[(float(v\[\"x\"]), float(v\[\"y\"])) for v in cam\[\"vanishingPoints\"]],\n        \"state\": state,\n    \}\n\n\ndef _core_sensor_size(camdata):\n    \"\"\"Preset si hay presetId con datos; si no, los valores custom. Offsets en mm.\"\"\"\n    preset = camdata.get(\"presetData\") or \{\}\n    if camdata.get(\"presetId\") and preset.get(\"sensorWidth\"):\n        return float(preset\[\"sensorWidth\"]), float(preset.get(\"sensorHeight\") or 0.0)\n    return float(camdata.get(\"customSensorWidth\") or 36.0), float(\n        camdata.get(\"customSensorHeight\") or 24.0\n    )\n\n\ndef core_extension_imagen(cabecera):\n    \"\"\"Extensión según la cabecera del blob. '' si no se reconoce.\"\"\"\n    for magia, extension in MAGIAS_IMAGEN:\n        if cabecera.startswith(magia):\n            return extension\n    return \"\"\n\n\ndef core_extraer_imagen(cam, carpeta):\n    \"\"\"Escribe la imagen embebida en `carpeta` y devuelve su ruta.\n\n    El .fspy no guarda una ruta a la foto: la lleva adentro. Extraerla hace que\n    el Read no dependa de que el artista no mueva el archivo original.\n    El nombre es el sha1 del contenido, así dos proyectos con la misma placa\n    comparten el archivo y re-extraer no duplica nada.\n    \"\"\"\n    if not cam.get(\"image_size\"):\n        raise ValueError(\"el proyecto .fspy no tiene imagen embebida (image_size = 0)\")\n\n    with open(cam\[\"path\"], \"rb\") as fh:\n        fh.seek(16 + cam\[\"state_size\"])\n        blob = fh.read(cam\[\"image_size\"])\n    if len(blob) != cam\[\"image_size\"]:\n        raise ValueError(\"imagen truncada: %d de %d bytes\" % (len(blob), cam\[\"image_size\"]))\n\n    extension = core_extension_imagen(blob\[:16])\n    if not extension:\n        raise ValueError(\n            \"imagen embebida con formato no reconocido (cabecera %s)\" % blob\[:8].hex()\n        )\n\n    os.makedirs(carpeta, exist_ok=True)\n    destino = os.path.join(\n        carpeta, \"plate_%s%s\" % (hashlib.sha1(blob).hexdigest()\[:12], extension)\n    )\n    if not os.path.exists(destino) or os.path.getsize(destino) != len(blob):\n        with open(destino, \"wb\") as fh:\n            fh.write(blob)\n    return destino\n\n\ndef _core_rows(node):\n    return \[\[float(x) for x in row] for row in node\[\"rows\"]]\n\n\ndef _core_length(v):\n    return math.sqrt(sum(c * c for c in v))\n\n\ndef core_matrix_flat(cam):\n    \"\"\"Las 16 componentes de cameraTransform (cámara -> mundo), fila por fila.\"\"\"\n    return tuple(x for row in cam\[\"camera_transform\"] for x in row)\n\n\ndef core_project_world_point(cam, point):\n    \"\"\"Proyecta un punto del mundo a coordenadas normalizadas de imagen (u, v) en \[-1, 1].\n\n    Sirve de autotest: el origen (0,0,0) tiene que volver al origen que el usuario\n    marcó en fSpy. Usa solo el archivo, sin Nuke.\n    \"\"\"\n    vt = cam\[\"view_transform\"]\n    x, y, z, w = point\[0], point\[1], point\[2], 1.0\n    px = vt\[0]\[0] * x + vt\[0]\[1] * y + vt\[0]\[2] * z + vt\[0]\[3] * w\n    py = vt\[1]\[0] * x + vt\[1]\[1] * y + vt\[1]\[2] * z + vt\[1]\[3] * w\n    pz = vt\[2]\[0] * x + vt\[2]\[1] * y + vt\[2]\[2] * z + vt\[2]\[3] * w\n    if pz >= -1e-9:\n        return None  # detrás del centro óptico\n    s = cam\[\"f_rel\"] / (-pz)\n    u0, v0 = cam\[\"principal_point\"]\n    u = u0 + s * px\n    v_tilde = v0 + s * py\n    return u, v_tilde * cam\[\"aspect\"]\n\n\ndef core_selftest(cam):\n    \"\"\"Comprueba que el origen marcado en el proyecto se reproyecta sobre sí mismo.\"\"\"\n    origin = ((cam.get(\"state\") or \{\}).get(\"controlPointsStateBase\") or \{\}).get(\"origin\")\n    if not origin:\n        return False, None, None\n    expected = (2.0 * float(origin\[\"x\"]) - 1.0, 1.0 - 2.0 * float(origin\[\"y\"]))\n    got = core_project_world_point(cam, (0.0, 0.0, 0.0))\n    if got is None:\n        return False, expected, None\n    err = max(abs(got\[0] - expected\[0]), abs(got\[1] - expected\[1]))\n    return err < 1e-9, expected, got\n\n\n# ------------------------------------------------------------------ panel\n_MODOS = \{\n    \"leer\": \"_leer\",\n    \"editar\": \"_editar\",\n    \"construir\": \"_construir\",\n    \"borrar\": \"_borrar\",\n    \"init\": \"_init\",\n\}\n\n_SUFIJO_CAMARA = \"cam\"\n_SUFIJO_CUBO = \"cube\"\n_SUFIJO_LECTURA = \"read\"\n\n#: Clase de nodo esperada para cada artefacto generado.\n_CLASES = \{_SUFIJO_CAMARA: \"Camera\", _SUFIJO_CUBO: \"Cube\", _SUFIJO_LECTURA: \"Read\"\}\n\n#: Desplazamiento (x, y) en el DAG de cada artefacto nuevo respecto del panel.\n_OFFSETS = \{_SUFIJO_LECTURA: (0, -140), _SUFIJO_CAMARA: (140, 0), _SUFIJO_CUBO: (280, 0)\}\n\n#: Knob oculto que marca que los defaults ya se forzaron una vez.\n_KNOB_INIT = \"fspy_init\"\n\n\ndef fspy_engine(accion, nodo=None):\n    \"\"\"Despachador de los botones. No abre diálogos: informa en el knob estado.\"\"\"\n    nodo = nodo or nuke.thisNode()\n    if nodo is None:\n        return None\n    funcion = globals().get(_MODOS.get(accion, \"\"))\n    if funcion is None:\n        raise ValueError(\"acción desconocida para fSpy: %r\" % (accion,))\n    try:\n        return funcion(nodo)\n    except Exception as exc:\n        _set(nodo, \"estado\", \"<span style='color:#e06c75'><b>%s</b>: %s</span>\"\n             % (type(exc).__name__, exc))\n        raise\n\n\ndef _set(nodo, nombre, valor):\n    \"\"\"setValue tolerante y sin ruido: solo escribe si el knob existe y cambia.\"\"\"\n    knob = nodo.knobs().get(nombre)\n    if knob is None:\n        return False\n    try:\n        if knob.value() == valor:\n            return False\n    except Exception:\n        pass\n    knob.setValue(valor)\n    return True\n\n\ndef _init(nodo):\n    \"\"\"Fuerza los defaults al pegar el nodo (lo llama onCreate).\n\n    Un .gizmo NO serializa un booleano cuando coincide con el default interno de\n    Nuke: al pegar, la casilla volvería a false. Por eso se fuerzan acá, pero\n    UNA sola vez: onCreate también corre al abrir el script, y sin la marca\n    `fspy_init` pisaría lo que el artista eligió (p. ej. el tamaño del cubo).\n    \"\"\"\n    marca = nodo.knobs().get(_KNOB_INIT)\n    if marca is not None and int(marca.value() or 0) >= 1:\n        return None\n    for nombre, valor in (\n        (\"crear_camara\", True),\n        (\"crear_cubo\", True),\n        (\"crear_read\", True),\n        (\"tamano_cubo\", 1.0),\n    ):\n        try:\n            _set(nodo, nombre, valor)\n        except Exception:\n            pass\n    _set(nodo, \"info\", \"\")\n    if marca is not None:\n        marca.setValue(1)\n    return None\n\n\n# ------------------------------------------------------------------ rutas\n_OS_CLAVES = (\"mac\", \"win\", \"linux\")\n\n\ndef _os_actual():\n    \"\"\"Clave de sistema operativo de esta máquina.\"\"\"\n    if sys.platform == \"darwin\":\n        return \"mac\"\n    if os.name == \"nt\":\n        return \"win\"\n    return \"linux\"\n\n\ndef _os_elegido(nodo):\n    \"\"\"OS efectivo: el del pulldown, o el real si está en «auto».\"\"\"\n    if \"fspy_os\" not in nodo.knobs():\n        return _os_actual()\n    try:\n        indice = int(nodo\[\"fspy_os\"].getValue())\n    except Exception:\n        return _os_actual()\n    if indice <= 0:\n        return _os_actual()\n    return _OS_CLAVES\[indice - 1]\n\n\ndef _ruta_fspy(nodo):\n    \"\"\"Ruta del .fspy para el OS elegido, con compatibilidad al knob de la v1.\n\n    Cada sistema tiene su propio campo porque una ruta guardada en un .nk no\n    sirve en otra máquina. Si el campo del OS está vacío se cae a `fspy_file`,\n    que es donde los scripts de la v1 guardaban la ruta.\n    \"\"\"\n    clave = \"fspy_file_%s\" % _os_elegido(nodo)\n    ruta = (nodo\[clave].value() or \"\").strip() if clave in nodo.knobs() else \"\"\n    if not ruta and \"fspy_file\" in nodo.knobs():\n        ruta = (nodo\[\"fspy_file\"].value() or \"\").strip()\n    if not ruta:\n        raise ValueError(\"no hay ruta .fspy configurada para %s\" % _os_elegido(nodo))\n    ruta = os.path.expandvars(os.path.expanduser(ruta))\n    if not os.path.isfile(ruta):\n        raise IOError(\"no existe el archivo (%s):\\n%s\" % (_os_elegido(nodo), ruta))\n    return ruta\n\n\ndef _leer(nodo):\n    \"\"\"Lee el .fspy y llena los campos de sólo lectura.\"\"\"\n    ruta = _ruta_fspy(nodo)\n    cam = core_read(ruta)\n    ok, _esperado, _obtenido = core_selftest(cam)\n\n    _set(nodo, \"r_modo\", cam\[\"mode\"])\n    _set(nodo, \"r_imagen\", \"%d x %d  (%.3f)\" % (cam\[\"width\"], cam\[\"height\"], cam\[\"aspect\"]))\n    _set(nodo, \"r_sensor\", \"%.2f x %.2f\" % (cam\[\"sensor_w_mm\"], cam\[\"sensor_h_mm\"]))\n    _set(nodo, \"r_focal\", \"%.2f mm   (f_rel = %.6f)\" % (cam\[\"focal_mm\"], cam\[\"f_rel\"]))\n    _set(nodo, \"r_fov\", \"%.2f° / %.2f°\" % (cam\[\"fov_h_deg\"], cam\[\"fov_v_deg\"]))\n    _set(nodo, \"r_principal\", \"%.4f, %.4f\" % cam\[\"principal_point\"]\n         + (\"   (centrado)\" if cam\[\"principal_point\"] == (0.0, 0.0) else \"\"))\n    _set(nodo, \"r_fuga\", \"  \".join(\"(%.4f, %.4f)\" % p for p in cam\[\"vanishing_points\"]\[:2]))\n    _set(nodo, \"r_escala\", \"λ = %.6f\" % cam\[\"scale\"])\n    referencia = cam\[\"reference_distance\"]\n    _set(nodo, \"r_referencia\", (\"%.4g %s\" % (referencia, cam\[\"reference_unit\"]))\n         if referencia else \"no definida (escala nominal)\")\n    _set(nodo, \"label\", os.path.basename(ruta))\n    _set(nodo, \"estado\", \"<span style='color:%s'>Origen reproyectado: %s</span>\"\n         % ((\"#7fb069\" if ok else \"#e06c75\"), \"exacto\" if ok else \"no coincide\"))\n    return cam\n\n\ndef _editar(nodo):\n    \"\"\"Abre el .fspy en la app fSpy para corregir la calibración.\"\"\"\n    ruta = _ruta_fspy(nodo)\n    try:\n        _lanzar_app(ruta)\n    except Exception as exc:\n        _set(nodo, \"info\", \"<span style='color:#e06c75'>no se pudo abrir fSpy: %s</span>\" % exc)\n        return False\n    _set(nodo, \"info\", \"abierto en fSpy → guardá allá y apretá «Leer .fspy» para recargar\")\n    return True\n\n\ndef _lanzar_app(ruta):\n    \"\"\"Abre el archivo con la aplicación asociada al .fspy, en cada plataforma.\"\"\"\n    if sys.platform == \"darwin\":\n        subprocess.Popen(\[\"open\", ruta])\n    elif os.name == \"nt\":\n        os.startfile(ruta)  # noqa: S606 - API estándar de Windows\n    else:\n        subprocess.Popen(\[\"xdg-open\", ruta])\n\n\ndef _construir(nodo):\n    \"\"\"Crea o actualiza cámara, cubo y read junto al panel, en SU contexto.\"\"\"\n    cam = _leer(nodo)  # valida antes de tocar el DAG\n    ctx = _contexto(nodo)\n    with ctx:\n        with nuke.Undo():\n            try:\n                nuke.Undo.name(\"fSpy Construir\")\n            except Exception:\n                pass\n            return _construir_nodos(nodo, cam)\n\n\ndef _construir_nodos(nodo, cam):\n    tamano = float(nodo\[\"tamano_cubo\"].value()) or 1.0\n    hechos = \[]\n    if nodo\[\"crear_camara\"].value():\n        _camara(nodo, cam)\n        hechos.append(_nombre_generado(nodo, _SUFIJO_CAMARA))\n    if nodo\[\"crear_cubo\"].value():\n        _cubo(nodo, tamano)\n        hechos.append(\"%s (%g u)\" % (_nombre_generado(nodo, _SUFIJO_CUBO), tamano))\n    if \"crear_read\" in nodo.knobs() and nodo\[\"crear_read\"].value():\n        ruta = _leer_imagen(nodo, cam)\n        hechos.append(\"%s (%s)\" % (_nombre_generado(nodo, _SUFIJO_LECTURA), os.path.basename(ruta)))\n    _set(nodo, \"info\", \"creado: \" + (\", \".join(hechos) if hechos else \"nada\"))\n    return cam\n\n\ndef _borrar(nodo):\n    ctx = _contexto(nodo)\n    borrados = \[]\n    with ctx:\n        with nuke.Undo():\n            try:\n                nuke.Undo.name(\"fSpy Borrar\")\n            except Exception:\n                pass\n            for sufijo in (_SUFIJO_CAMARA, _SUFIJO_CUBO, _SUFIJO_LECTURA):\n                nombre = _nombre_generado(nodo, sufijo)\n                existente = nuke.toNode(nombre)\n                if existente is not None:\n                    nuke.delete(existente)\n                    borrados.append(nombre)\n    _set(nodo, \"info\", \"eliminado: \" + (\", \".join(borrados) if borrados else \"no había nada\"))\n\n\n# ------------------------------------------------------------------ nodos\ndef _nombre_generado(panel, sufijo):\n    \"\"\"Nombre estable de un artefacto, derivado del nombre actual del panel.\"\"\"\n    return \"%s_%s\" % (panel.name(), sufijo)\n\n\ndef _camara(panel, cam):\n    nodo = _obtener(panel, _SUFIJO_CAMARA)\n    nodo\[\"haperture\"].setValue(cam\[\"sensor_w_mm\"])\n    nodo\[\"vaperture\"].setValue(cam\[\"sensor_h_mm\"] or cam\[\"sensor_w_mm\"] / cam\[\"aspect\"])\n    nodo\[\"focal\"].setValue(cam\[\"focal_mm\"])\n    # el punto principal viene en medio ancho; Nuke lo espera como fracción de ancho\n    principal_u, principal_v = cam\[\"principal_point\"]\n    nodo\[\"win_translate\"].setValue(\[principal_u / 2.0, principal_v / 2.0 / cam\[\"aspect\"]])\n    distancia = max(cam\[\"scale\"], 1e-3)\n    nodo\[\"near\"].setValue(distancia * 0.001)\n    nodo\[\"far\"].setValue(distancia * 1000.0)\n    if \"useMatrix\" in nodo.knobs():\n        nodo\[\"useMatrix\"].setValue(True)\n    nodo\[\"matrix\"].setValue(core_matrix_flat(cam))\n    return nodo\n\n\ndef _carpeta_cache():\n    \"\"\"Carpeta estable para las placas extraídas. Cae a temp si ~/.nuke no se puede escribir.\"\"\"\n    for base in (\n        os.path.join(os.path.expanduser(\"~\"), \".nuke\", \"fspy_cache\"),\n        os.path.join(tempfile.gettempdir(), \"fspy_cache\"),\n    ):\n        try:\n            os.makedirs(base, exist_ok=True)\n            if os.access(base, os.W_OK):\n                return base\n        except OSError:\n            continue\n    raise IOError(\"no hay carpeta escribible para extraer la imagen del .fspy\")\n\n\ndef _carpeta_cache_portable():\n    \"\"\"Carpeta de caché bajo el home: la única ruta que se puede expresar portable.\"\"\"\n    return os.path.join(os.path.expanduser(\"~\"), \".nuke\", \"fspy_cache\")\n\n\ndef _expresion_cache(ruta, carpeta):\n    \"\"\"Valor para la knob `file` del Read.\n\n    Si la caché quedó bajo el home, se escribe una expresión `\[python \{...\}]`\n    que Nuke evalúa en cada máquina, así el .nk no guarda el home de quien lo\n    autoró. Si cayó al temporal no hay forma portable y se usa la ruta literal.\n    \"\"\"\n    portable = _carpeta_cache_portable()\n    if os.path.normcase(os.path.abspath(carpeta)) != os.path.normcase(os.path.abspath(portable)):\n        return ruta\n    nombre = os.path.basename(ruta)\n    return '\[python \{os.path.join(os.path.expanduser(\"~\"), \".nuke\", \"fspy_cache\", \"%s\")\}]' % nombre\n\n\ndef _leer_imagen(panel, cam):\n    \"\"\"Extrae la foto embebida en el .fspy y la apunta desde un Read portable.\"\"\"\n    carpeta = _carpeta_cache()\n    ruta = core_extraer_imagen(cam, carpeta).replace(\"\\\\\", \"/\")\n    nodo = _obtener(panel, _SUFIJO_LECTURA)\n    nodo\[\"file\"].setValue(_expresion_cache(ruta, carpeta))\n    return ruta\n\n\ndef _cubo(panel, tamano):\n    nodo = _obtener(panel, _SUFIJO_CUBO)\n    nodo\[\"scaling\"].setValue(\[tamano, tamano, tamano])\n    nodo\[\"translate\"].setValue(\[0.0, tamano / 2.0, 0.0])  # apoyado, no atravesado\n    return nodo\n\n\n# ------------------------------------------------------------------ contexto\ndef _contexto(nodo):\n    \"\"\"Grupo donde vive el panel, derivado de su path real.\n\n    No se guarda el contexto en un knob: un string guardado queda obsoleto en\n    cuanto el nodo se copia a otro script o se renombra el grupo, y ahí los\n    artefactos aparecen en la raíz sin que nadie entienda por qué.\n    \"\"\"\n    completo = nodo.fullName()\n    if \".\" not in completo:\n        return nuke.root()\n    return nuke.toNode(completo.rsplit(\".\", 1)\[0]) or nuke.root()\n\n\ndef _obtener(panel, sufijo):\n    \"\"\"Devuelve el artefacto `sufijo` del panel, creándolo solo si falta.\n\n    Se llama dentro de `with contexto`. Si ya existe con la clase correcta se\n    reutiliza: conserva posición, conexiones y ajustes manuales del artista.\n    Si existe con otra clase (un nodo ajeno con ese nombre) se reemplaza.\n    \"\"\"\n    nombre = _nombre_generado(panel, sufijo)\n    clase = _CLASES\[sufijo]\n    existente = nuke.toNode(nombre)\n    if existente is not None:\n        if existente.Class() == clase:\n            return existente\n        nuke.delete(existente)\n    dx, dy = _OFFSETS\[sufijo]\n    nodo = getattr(nuke.nodes, clase)(xpos=panel.xpos() + dx, ypos=panel.ypos() + dy)\n    nodo.setName(nombre)\n    return nodo\n\n\n# Punto de entrada: los botones pasan la acción en el namespace privado del exec.\nif \"_FSPY_ACCION\" in globals():\n    fspy_engine(_FSPY_ACCION)  # noqa: F821 - inyectada por el exec del botón\n"}
 addUserKnob {26 creditos l Créditos T "Samán Estudio SAS. emanuel.barriga@samanestudio.com"}
 addUserKnob {20 Rutas}
 addUserKnob {4 fspy_os l "Rutas por sistema" M {auto macOS Windows Linux}}
 addUserKnob {2 fspy_file_mac l "Proyecto .fspy (macOS)"}
 addUserKnob {2 fspy_file_win l "Proyecto .fspy (Windows)"}
 addUserKnob {2 fspy_file_linux l "Proyecto .fspy (Linux)"}
}
