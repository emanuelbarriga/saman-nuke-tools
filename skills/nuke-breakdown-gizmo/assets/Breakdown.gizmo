 ContactSheet {
  inputs 3
  width {{input.width*columns*resMult}}
  height {{input.height*rows*resMult}}
  rows 2
  columns 2
  center true
  roworder TopBottom
  name ContactSheetAuto
  tile_color 0xff69f7ff
  xpos -504
  ypos 411
  addUserKnob {20 Settings}
  addUserKnob {7 resMult l "Resolution Multiplier" R 0.1 2}
  resMult 1
 }
